{
  "version": "1.0",
  "description": "Central index of Cursor rules for automatic context-aware application",
  "rules": [
    {
      "id": "thinking-timer",
      "file": "thinking-timer.mdc",
      "description": "Show thinking timer for operations taking longer than 2 seconds",
      "filePatterns": [
        "**/*.sh",
        "**/*.py",
        "**/bin/**",
        "**/zsh/functions/**"
      ],
      "matchStrings": [
        "show_thinking_timer",
        "run_with_thinking_timer",
        "LLM",
        "API call",
        "web search",
        "network request",
        "long-running",
        "timeout",
        "urllib.request",
        "lmstudio",
        "ollama"
      ],
      "alwaysApply": true,
      "priority": 10,
      "categories": ["performance", "ux", "bash", "python"]
    },
    {
      "id": "macos-bash-compatibility",
      "file": "macos-bash-compatibility.mdc",
      "description": "macOS bash compatibility - avoid bash 4+ features",
      "filePatterns": [
        "**/*.sh",
        "**/bin/**"
      ],
      "matchStrings": [
        "bad substitution",
        "${var^}",
        "${var^^}",
        "${var,}",
        "${var,,}",
        "declare -A",
        "associative array",
        "bash 4",
        "capitalize",
        "uppercase",
        "lowercase",
        "macOS",
        "mac os"
      ],
      "alwaysApply": true,
      "priority": 10,
      "categories": ["bash", "compatibility", "quality"]
    },
    {
      "id": "unit-testing",
      "file": "unit-testing.mdc",
      "description": "Require unit tests for all new code",
      "filePatterns": [
        "**/*.sh",
        "**/*.py",
        "**/bin/**",
        "**/zsh/functions/**",
        "**/tests/**"
      ],
      "matchStrings": [
        "def ",
        "function ",
        "test_",
        "unittest",
        "pytest",
        "new feature",
        "add functionality",
        "implement",
        "create function"
      ],
      "alwaysApply": true,
      "priority": 9,
      "categories": ["testing", "quality", "bash", "python"]
    },
    {
      "id": "dry-principle",
      "file": "dry-principle.mdc",
      "description": "Don't Repeat Yourself - reuse existing code and functions",
      "filePatterns": [
        "**/*.sh",
        "**/*.py",
        "**/bin/**",
        "**/zsh/functions/**"
      ],
      "matchStrings": [
        "find.*PROJECTS_PATH",
        "find.*AREAS_PATH",
        "find.*TASKS_PATH",
        "grep.*frontmatter",
        "select.*project",
        "list.*project",
        "duplicate",
        "reimplement",
        "new function",
        "create.*helper"
      ],
      "alwaysApply": true,
      "priority": 9,
      "categories": ["quality", "maintainability", "bash", "python"]
    },
    {
      "id": "pause-functions",
      "file": "pause-functions.mdc",
      "description": "When to use gtd_enter_to_continue vs gtd_quick_pause",
      "filePatterns": [
        "**/*.sh",
        "**/bin/**",
        "**/zsh/functions/**"
      ],
      "matchStrings": [
        "gtd_quick_pause",
        "gtd_enter_to_continue",
        "gtd_pause",
        "review",
        "report",
        "display",
        "show.*task",
        "list.*task",
        "analysis result",
        "summary",
        "dashboard"
      ],
      "alwaysApply": true,
      "priority": 8,
      "categories": ["ux", "bash", "quality"]
    },
    {
      "id": "architecture-decisions",
      "file": "architecture-decisions.mdc",
      "description": "Maintain architecture decisions documentation as system evolves",
      "filePatterns": [
        "**/*.sh",
        "**/*.py",
        "**/bin/**",
        "**/mcp/**",
        "docs/**"
      ],
      "matchStrings": [
        "architecture decision",
        "architectural change",
        "new infrastructure",
        "new database",
        "new framework",
        "ADR",
        "message queue",
        "sync mechanism",
        "storage architecture",
        "infrastructure",
        "deployment",
        "technology choice",
        "trade-off",
        "decision record"
      ],
      "alwaysApply": false,
      "priority": 7,
      "categories": ["documentation", "architecture", "maintainability"]
    },
    {
      "id": "ollama-controller-async",
      "file": "ollama-controller-async.mdc",
      "description": "Always handle async responses from Ollama Controller",
      "filePatterns": [
        "**/*.py",
        "**/mcp/**",
        "**/zsh/functions/**"
      ],
      "matchStrings": [
        "urllib.request",
        "requests.post",
        "31080",
        "OLLAMA_URL",
        "DEEP_MODEL_URL",
        "chat/completions",
        "/v1/chat/completions",
        "call.*ai",
        "request.*ai",
        "Ollama Controller",
        "status.*queued",
        "request_id"
      ],
      "alwaysApply": false,
      "priority": 8,
      "categories": ["python", "quality", "maintainability", "api"]
    },
    {
      "id": "gtd-coordination",
      "file": "gtd-coordination.mdc",
      "description": "Prevent duplicate GTD operations between TUI and background workers using coordination system",
      "filePatterns": [
        "**/*.py",
        "**/mcp/**",
        "**/zsh/functions/**",
        "**/bin/gtd-*",
        "**/skills/**/*.md",
        "**/workers/**"
      ],
      "matchStrings": [
        "gtd_create_task",
        "create_task",
        "process_daily_log",
        "meeting_notes",
        "auto-task-creation",
        "task creation",
        "background worker",
        "EnhancedGTDTools",
        "gtd_coordination",
        "duplicate",
        "coordination",
        "conflict prevention"
      ],
      "alwaysApply": false,
      "priority": 10,
      "categories": ["gtd", "coordination", "workers", "quality"]
    }
  ],
  "categories": {
    "performance": "Rules related to performance optimization",
    "ux": "Rules related to user experience",
    "testing": "Rules related to testing and quality assurance",
    "quality": "Rules related to code quality",
    "bash": "Rules specific to bash/shell scripts",
    "python": "Rules specific to Python code",
    "compatibility": "Rules related to cross-platform and version compatibility",
    "maintainability": "Rules related to code maintainability and DRY principles",
    "documentation": "Rules related to maintaining documentation",
    "architecture": "Rules related to system architecture and design decisions",
    "gtd": "Rules specific to GTD system operations",
    "coordination": "Rules related to preventing conflicts between system components",
    "workers": "Rules specific to background worker implementations"
  },
  "matchLogic": {
    "description": "Rules are matched when ANY filePattern OR matchString matches",
    "priority": "Higher priority rules are applied first",
    "alwaysApply": "Rules with alwaysApply=true are always included regardless of matches"
  }
}
