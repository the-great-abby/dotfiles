#!/bin/bash
# Switch GTD AI system to hybrid mode (smart routing between Ollama + Claude)

set -e

CONFIG_FILE="${HOME}/.gtd_config_ai"
if [[ ! -f "$CONFIG_FILE" && -f "${HOME}/code/dotfiles/zsh/.gtd_config_ai" ]]; then
    CONFIG_FILE="${HOME}/code/dotfiles/zsh/.gtd_config_ai"
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "❌ Config file not found: $CONFIG_FILE"
    exit 1
fi

# Update the config file
if grep -q "GTD_AI_MODE=" "$CONFIG_FILE"; then
    # macOS-compatible sed
    sed -i '' 's/GTD_AI_MODE=.*/GTD_AI_MODE="hybrid"/' "$CONFIG_FILE"
else
    echo 'GTD_AI_MODE="hybrid"' >> "$CONFIG_FILE"
fi

echo "✅ Switched to hybrid mode"
echo ""
echo "Simple tasks → Ollama (fast, local)"
echo "Complex tasks → Claude (quality, API)"
echo ""
echo "Make sure ANTHROPIC_API_KEY is set:"
echo "  export ANTHROPIC_API_KEY=sk-..."
echo ""
echo "Config: $CONFIG_FILE"
