#!/bin/bash
# Check RabbitMQ Queue Status
# Shows messages, consumers, and processing status for GTD queues

set -e

# Parse command-line arguments
USE_COLOR=true
for arg in "$@"; do
    case "$arg" in
        --no-color|--plain|--color=never)
            USE_COLOR=false
            ;;
        --color|--color=always|--color=auto)
            USE_COLOR=true
            ;;
        -h|--help)
            echo "Usage: gtd-rabbitmq-status [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --no-color, --plain, --color=never    Disable colored output"
            echo "  --color, --color=always, --color=auto  Enable colored output (default)"
            echo "  -h, --help                            Show this help message"
            exit 0
            ;;
    esac
done

# Check NO_COLOR environment variable (common standard)
if [[ -n "$NO_COLOR" ]] || [[ "$NO_COLOR" == "1" ]]; then
    USE_COLOR=false
fi

# Set colors based on USE_COLOR flag
if [[ "$USE_COLOR" == "true" ]] && [[ -t 1 ]]; then
    # Terminal supports colors and output is to terminal
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    RED='\033[0;31m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    NC='\033[0m' # No Color
else
    # No colors
    GREEN=''
    YELLOW=''
    RED=''
    CYAN=''
    BOLD=''
    NC=''
fi

# Find Python executable (prefer virtualenv)
MCP_VENV="$HOME/code/dotfiles/mcp/venv/bin/python3"
if [[ ! -f "$MCP_VENV" ]]; then
    MCP_VENV="$HOME/code/personal/dotfiles/mcp/venv/bin/python3"
fi

if [[ -f "$MCP_VENV" ]]; then
    PYTHON_CMD="$MCP_VENV"
else
    PYTHON_CMD="python3"
fi

# Read config
GTD_CONFIG_DIR="${HOME}/code/dotfiles/zsh"
if [[ -f "${GTD_CONFIG_DIR}/.gtd_config_database" ]]; then
    source "${GTD_CONFIG_DIR}/.gtd_config_database"
fi

# Get RabbitMQ settings
RABBITMQ_URL="${RABBITMQ_URL:-amqp://localhost:5672}"
RABBITMQ_USER="${RABBITMQ_USER:-guest}"
RABBITMQ_PASS="${RABBITMQ_PASS:-guest}"

# Build URL with credentials if not in URL
if [[ "$RABBITMQ_URL" != *"@"* ]]; then
    if [[ -n "$RABBITMQ_USER" ]]; then
        if [[ -n "$RABBITMQ_PASS" ]]; then
            RABBITMQ_URL="amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@${RABBITMQ_URL#amqp://}"
        else
            RABBITMQ_URL="amqp://${RABBITMQ_USER}@${RABBITMQ_URL#amqp://}"
        fi
    fi
fi

echo -e "${BOLD}${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BOLD}${CYAN}📊 RabbitMQ Queue Status${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Check RabbitMQ connection and get queue stats
export RABBITMQ_URL_TO_CHECK="$RABBITMQ_URL"
export USE_COLOR="$USE_COLOR"
"$PYTHON_CMD" << 'EOF'
import os
import sys
import json
import pika
from datetime import datetime

rabbitmq_url = os.environ.get('RABBITMQ_URL_TO_CHECK')
if not rabbitmq_url:
    use_color = os.environ.get('USE_COLOR', 'true').lower() == 'true'
    if use_color:
        print("\033[0;31m❌ Error: RABBITMQ_URL_TO_CHECK not set\033[0m")
    else:
        print("❌ Error: RABBITMQ_URL_TO_CHECK not set")
    sys.exit(1)

# Check if colors should be used
use_color = os.environ.get('USE_COLOR', 'true').lower() == 'true'
# Also check if output is to a terminal
if use_color and not sys.stdout.isatty():
    use_color = False

# Color codes (empty if no color)
if use_color:
    GREEN = '\033[0;32m'
    YELLOW = '\033[1;33m'
    RED = '\033[0;31m'
    CYAN = '\033[0;36m'
    BOLD = '\033[1m'
    NC = '\033[0m'
else:
    GREEN = YELLOW = RED = CYAN = BOLD = NC = ''

deep_queue = "gtd_deep_analysis"
vector_queue = "gtd_vectorization"
advice_queue = "gtd_advice"

try:
    # Connect to RabbitMQ with timeout
    # Note: pika uses connection_attempts and retry_delay for connection timeouts
    # For socket timeout, we use socket_timeout in URLParameters
    params = pika.URLParameters(rabbitmq_url)
    params.socket_timeout = 5  # 5 second socket timeout
    params.connection_attempts = 2  # Only try twice
    params.retry_delay = 2  # Wait 2 seconds between attempts
    
    connection = pika.BlockingConnection(params)
    channel = connection.channel()
    
    print(f"{GREEN}✅ Connected to RabbitMQ{NC}")
    print(f"   URL: {rabbitmq_url.split('@')[-1]}")  # Hide credentials
    print("")
    
    # Helper to get queue info
    def get_queue_info(queue_name):
        try:
            # Declare queue (passive=False to create if needed)
            result = channel.queue_declare(queue=queue_name, durable=True, passive=False)
            message_count = result.method.message_count
            consumer_count = result.method.consumer_count
            
            # Get queue details
            queue_info = {
                'name': queue_name,
                'messages': message_count,
                'consumers': consumer_count,
                'exists': True
            }
            
            # Try to get more details (may not work on all RabbitMQ versions)
            try:
                # Get messages ready/unacknowledged
                queue_stats = channel.queue_declare(queue=queue_name, durable=True, passive=True)
                queue_info['messages_ready'] = queue_stats.method.message_count
            except:
                pass
                
            return queue_info
        except Exception as e:
            return {
                'name': queue_name,
                'messages': 0,
                'consumers': 0,
                'exists': False,
                'error': str(e)
            }
    
    # Check Deep Analysis queue
    print(f"{BOLD}Deep Analysis Queue:{NC}")
    deep_info = get_queue_info(deep_queue)
    if deep_info['exists']:
        print(f"   Queue: {CYAN}{deep_info['name']}{NC}")
        print(f"   Messages waiting: {YELLOW}{deep_info['messages']}{NC}")
        print(f"   Active consumers: {GREEN}{deep_info['consumers']}{NC}")
        
        if deep_info['messages'] > 0 and deep_info['consumers'] == 0:
            print(f"   {YELLOW}⚠️  Warning: Messages queued but no consumers!{NC}")
            print("      Start worker: make worker-deep-start")
            print("      Check status: make worker-status")
        elif deep_info['messages'] == 0 and deep_info['consumers'] > 0:
            print(f"   {GREEN}✅ Queue empty, worker waiting for jobs{NC}")
        elif deep_info['messages'] > 0 and deep_info['consumers'] > 0:
            print(f"   {GREEN}🔄 Jobs being processed{NC}")
        else:
            print(f"   {CYAN}ℹ️  Queue empty, no workers connected{NC}")
    else:
        print(f"   {YELLOW}⚠️  Queue '{deep_queue}' not found{NC}")
    print("")
    
    # Check Vectorization queue
    print(f"{BOLD}Vectorization Queue:{NC}")
    vector_info = get_queue_info(vector_queue)
    if vector_info['exists']:
        print(f"   Queue: {CYAN}{vector_info['name']}{NC}")
        print(f"   Messages waiting: {YELLOW}{vector_info['messages']}{NC}")
        print(f"   Active consumers: {GREEN}{vector_info['consumers']}{NC}")
        
        if vector_info['messages'] > 0 and vector_info['consumers'] == 0:
            print(f"   {YELLOW}⚠️  Warning: Messages queued but no consumers!{NC}")
            print("      Start worker: make worker-vector-start")
            print("      Check status: make worker-status")
        elif vector_info['messages'] == 0 and vector_info['consumers'] > 0:
            print(f"   {GREEN}✅ Queue empty, worker waiting for jobs{NC}")
        elif vector_info['messages'] > 0 and vector_info['consumers'] > 0:
            print(f"   {GREEN}🔄 Jobs being processed{NC}")
        else:
            print(f"   {CYAN}ℹ️  Queue empty, no workers connected{NC}")
    else:
        print(f"   {YELLOW}⚠️  Queue '{vector_queue}' not found{NC}")
    print("")
    
    # Check Advice queue
    print(f"{BOLD}Advice Queue:{NC}")
    advice_info = get_queue_info(advice_queue)
    if advice_info['exists']:
        print(f"   Queue: {CYAN}{advice_info['name']}{NC}")
        print(f"   Messages waiting: {YELLOW}{advice_info['messages']}{NC}")
        print(f"   Active consumers: {GREEN}{advice_info['consumers']}{NC}")
        
        if advice_info['messages'] > 0 and advice_info['consumers'] == 0:
            print(f"   {YELLOW}⚠️  Warning: Messages queued but no consumers!{NC}")
            print("      Start worker: gtd-advice-worker daemon")
            print("      Check status: make worker-status")
        elif advice_info['messages'] == 0 and advice_info['consumers'] > 0:
            print(f"   {GREEN}✅ Queue empty, worker waiting for jobs{NC}")
        elif advice_info['messages'] > 0 and advice_info['consumers'] > 0:
            print(f"   {GREEN}🔄 Jobs being processed{NC}")
        else:
            print(f"   {CYAN}ℹ️  Queue empty, no workers connected{NC}")
    else:
        print(f"   {YELLOW}⚠️  Queue '{advice_queue}' not found{NC}")
    print("")
    
    connection.close()
    
except ImportError:
    print(f"{RED}❌ Error: pika not installed{NC}")
    print("   Install with: pip install pika")
    print("   Or in virtualenv: $HOME/code/dotfiles/mcp/venv/bin/pip install pika")
    sys.exit(1)
except (pika.exceptions.AMQPConnectionError, ConnectionRefusedError, OSError) as e:
    print(f"{RED}❌ Cannot connect to RabbitMQ{NC}")
    error_msg = str(e) if str(e) else "Connection refused"
    print(f"   Error: {error_msg}")
    print("")
    print("   Make sure:")
    print("   1. RabbitMQ is running")
    print("   2. Port-forward is active (if using Kubernetes):")
    print("      kubectl port-forward -n rabbitmq-system svc/rabbitmq 5672:5672 15672:15672 15692:15692")
    print("   3. Check if port-forward is running:")
    print("      ps aux | grep 'kubectl port-forward.*5672'")
    print("   4. RABBITMQ_URL is correct in .gtd_config_database")
    print("")
    print("   Quick check: nc -zv localhost 5672")
    sys.exit(1)
except Exception as e:
    print(f"{RED}❌ Error: {e}{NC}")
    sys.exit(1)
EOF

# Also show file queue status (fallback)
echo -e "${BOLD}File Queue Status (Fallback):${NC}"
echo ""

# Deep Analysis file queue
DEEP_QUEUE_FILE="${HOME}/Documents/gtd/deep_analysis_queue.jsonl"
if [[ -f "$DEEP_QUEUE_FILE" ]]; then
    deep_count=$(wc -l < "$DEEP_QUEUE_FILE" 2>/dev/null || echo "0")
    if [[ "$deep_count" -gt 0 ]]; then
        echo -e "   Deep Analysis: ${YELLOW}$deep_count message(s)${NC}"
        echo -e "   File: ${CYAN}$DEEP_QUEUE_FILE${NC}"
    else
        echo -e "   Deep Analysis: ${GREEN}Empty${NC}"
    fi
else
    echo -e "   Deep Analysis: ${CYAN}No queue file${NC}"
fi

# Vectorization file queue
VECTOR_QUEUE_FILE="${HOME}/Documents/gtd/vectorization_queue.jsonl"
if [[ -f "$VECTOR_QUEUE_FILE" ]]; then
    vector_count=$(wc -l < "$VECTOR_QUEUE_FILE" 2>/dev/null || echo "0")
    if [[ "$vector_count" -gt 0 ]]; then
        echo -e "   Vectorization: ${YELLOW}$vector_count message(s)${NC}"
        echo -e "   File: ${CYAN}$VECTOR_QUEUE_FILE${NC}"
    else
        echo -e "   Vectorization: ${GREEN}Empty${NC}"
    fi
else
    echo -e "   Vectorization: ${CYAN}No queue file${NC}"
fi

# Advice file queue
ADVICE_QUEUE_FILE="${HOME}/Documents/gtd/advice_queue.jsonl"
if [[ -f "$ADVICE_QUEUE_FILE" ]]; then
    advice_count=$(wc -l < "$ADVICE_QUEUE_FILE" 2>/dev/null || echo "0")
    if [[ "$advice_count" -gt 0 ]]; then
        echo -e "   Advice: ${YELLOW}$advice_count message(s)${NC}"
        echo -e "   File: ${CYAN}$ADVICE_QUEUE_FILE${NC}"
    else
        echo -e "   Advice: ${GREEN}Empty${NC}"
    fi
else
    echo -e "   Advice: ${CYAN}No queue file${NC}"
fi

echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
