        show_command_category "Daily Logging & Tracking" "addInfoToDailyLog|gtd-daily-log|gtd-log"
        ;;
      6)
        show_command_category "Reviews & Planning" "gtd-review|gtd-morning|gtd-evening|gtd-afternoon|gtd-plan"
        ;;
      7)
        show_command_category "Second Brain & Knowledge" "gtd-brain"
