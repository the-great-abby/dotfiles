#!/bin/bash
# Start GTD Task Organization Worker
# Processes task organization queue from RabbitMQ or file queue

# Find Python executable (check virtualenv first)
MCP_DIR="$HOME/code/dotfiles/mcp"
if [[ ! -d "$MCP_DIR" ]]; then
    MCP_DIR="$HOME/code/personal/dotfiles/mcp"
fi

VENV_PYTHON="${MCP_DIR}/venv/bin/python3"
if [[ -f "$VENV_PYTHON" ]]; then
    PYTHON_CMD="$VENV_PYTHON"
else
    PYTHON_CMD="python3"
fi

WORKER_SCRIPT="${MCP_DIR}/gtd_task_organize_worker.py"

if [[ ! -f "$WORKER_SCRIPT" ]]; then
    echo "Error: Worker script not found at $WORKER_SCRIPT" >&2
    exit 1
fi

# Load RabbitMQ URL from config file if not set
if [[ -z "$GTD_RABBITMQ_URL" ]]; then
    CONFIG_FILE="$HOME/code/dotfiles/zsh/.gtd_config_database"
    if [[ ! -f "$CONFIG_FILE" ]]; then
        CONFIG_FILE="$HOME/code/personal/dotfiles/zsh/.gtd_config_database"
    fi
    if [[ -f "$CONFIG_FILE" ]]; then
        # Source the config file to get RABBITMQ_URL
        source "$CONFIG_FILE" 2>/dev/null || true
        # Use RABBITMQ_URL if set, otherwise keep default
        if [[ -n "$RABBITMQ_URL" ]]; then
            export GTD_RABBITMQ_URL="$RABBITMQ_URL"
        fi
    fi
fi

# Log startup info
LOG_FILE="/tmp/task-org-worker.log"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting task organization worker..." >> "$LOG_FILE"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Queue: gtd_task_organization" >> "$LOG_FILE"
if [[ -n "$GTD_RABBITMQ_URL" ]]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] RabbitMQ URL: $GTD_RABBITMQ_URL" >> "$LOG_FILE"
fi

# Check if processing file queue
if [[ "$1" == "file" ]]; then
    echo "Processing file queue..."
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Processing file queue..." >> "$LOG_FILE"
    exec "$PYTHON_CMD" "$WORKER_SCRIPT" file
else
    echo "Starting task organization worker..."
    echo "Queue: gtd_task_organization"
    if [[ -n "$GTD_RABBITMQ_URL" ]]; then
        echo "RabbitMQ URL: $GTD_RABBITMQ_URL"
    fi
    echo "Press Ctrl+C to stop"
    echo "Logs: $LOG_FILE"
    echo ""
    
    # Run with exec to ensure proper signal handling
    # Add error logging to stderr (which goes to log file when run with nohup)
    exec "$PYTHON_CMD" "$WORKER_SCRIPT" rabbitmq 2>&1
fi


