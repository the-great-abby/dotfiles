#!/bin/bash
# Check Ollama request logs to debug timeouts and stuck requests

LOG_FILE="$HOME/.gtd_logs/tool_calls.log"

if [[ ! -f "$LOG_FILE" ]]; then
  echo "❌ Log file doesn't exist yet: $LOG_FILE"
  echo "   It will be created on first Ollama request."
  exit 1
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📋 Ollama Request Logs"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "Log file: $LOG_FILE"
echo ""

# Show last N lines (default 100)
LINES="${1:-100}"

echo "Last $LINES lines (filtered for Ollama requests):"
echo ""

# Show with timestamps highlighted, filtering for Ollama-related entries
# Look for Ollama URL (localhost:11434), Ollama backend mentions, or Ollama-specific errors
tail -n "$LINES" "$LOG_FILE" | grep -E "(ollama|Ollama|11434|Sending request.*ollama|API Response.*ollama|ERROR.*ollama|timed out.*ollama|elapsed)" -i | tail -30

# If no Ollama-specific entries found, show all recent entries that might be Ollama
if [[ $(tail -n "$LINES" "$LOG_FILE" | grep -E "(ollama|Ollama|11434)" -i | wc -l) -eq 0 ]]; then
  echo ""
  echo "⚠️  No Ollama-specific entries found in recent logs."
  echo "   Showing all recent entries (may include LM Studio requests):"
  echo ""
  tail -n "$LINES" "$LOG_FILE" | grep -E "(Sending request|API Response|ERROR|timed out|elapsed)" | tail -20
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "💡 Tips:"
echo "   - Look for 'Sending request' to see when requests start"
echo "   - Look for 'API Response received' to see when they complete"
echo "   - Look for 'ERROR' or 'timed out' to see failures"
echo "   - Check 'elapsed' time to see how long requests took"
echo "   - Ollama uses port 11434 (vs LM Studio's 1234)"
echo ""
echo "To see full recent logs:"
echo "   tail -100 $LOG_FILE"
echo ""
echo "To watch logs in real-time:"
echo "   tail -f $LOG_FILE | grep -i ollama"
echo ""

