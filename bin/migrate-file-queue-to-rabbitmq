#!/bin/bash
# Migrate messages from file queue to RabbitMQ
# Reads messages from file queue and publishes them to RabbitMQ when available

# Find Python executable (check virtualenv first)
MCP_DIR="$HOME/code/dotfiles/mcp"
if [[ ! -d "$MCP_DIR" ]]; then
    MCP_DIR="$HOME/code/personal/dotfiles/mcp"
fi

VENV_PYTHON="${MCP_DIR}/venv/bin/python3"
if [[ -f "$VENV_PYTHON" ]]; then
    PYTHON_CMD="$VENV_PYTHON"
else
    PYTHON_CMD="python3"
fi

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m' # No Color

QUEUE_FILE="${HOME}/Documents/gtd/vectorization_queue.jsonl"

if [[ ! -f "$QUEUE_FILE" ]] || [[ ! -s "$QUEUE_FILE" ]]; then
    echo -e "${YELLOW}⚠️  File queue is empty or doesn't exist${NC}"
    echo "   File: $QUEUE_FILE"
    exit 0
fi

# Count messages in file queue
MESSAGE_COUNT=$(wc -l < "$QUEUE_FILE" | tr -d ' ')
echo -e "${CYAN}Found ${MESSAGE_COUNT} message(s) in file queue${NC}"
echo ""

# Check if RabbitMQ is available (NodePort or port-forward)
echo -e "${CYAN}Checking RabbitMQ connection...${NC}"

# Try NodePort first (192.168.64.2:30672), then fallback to localhost:5672 (port-forward)
RABBITMQ_AVAILABLE=false
if nc -zv 192.168.64.2 30672 &>/dev/null 2>&1; then
    echo -e "${GREEN}✓ RabbitMQ NodePort is accessible (192.168.64.2:30672)${NC}"
    RABBITMQ_AVAILABLE=true
elif nc -zv localhost 5672 &>/dev/null 2>&1; then
    echo -e "${GREEN}✓ RabbitMQ port-forward is active (localhost:5672)${NC}"
    RABBITMQ_AVAILABLE=true
fi

if [[ "$RABBITMQ_AVAILABLE" == "false" ]]; then
    echo -e "${RED}❌ RabbitMQ not accessible${NC}"
    echo ""
    echo "Please ensure RabbitMQ is accessible via:"
    echo "  - NodePort: 192.168.64.2:30672 (preferred, no port-forward needed)"
    echo "  - Port-forward: localhost:5672 (legacy)"
    echo ""
    echo "Check connection info:"
    echo "  cd ~/code/external_services/rabbitmq && make connection-info"
    exit 1
fi

echo ""

# Run Python script to migrate
cat > /tmp/migrate_queue.py << PYTHON_EOF
#!/usr/bin/env python3
"""Migrate messages from file queue to RabbitMQ."""
import json
import sys
import os
from pathlib import Path

# Add dotfiles directory to path
dotfiles_dir = Path("$HOME/code/dotfiles")
if not dotfiles_dir.exists():
    dotfiles_dir = Path("$HOME/code/personal/dotfiles")

sys.path.insert(0, str(dotfiles_dir))
sys.path.insert(0, str(dotfiles_dir / "zsh" / "functions"))

# Import functions
from gtd_vectorization import queue_vectorization
from gtd_vector_db import read_database_config

queue_file = Path.home() / "Documents" / "gtd" / "vectorization_queue.jsonl"

if not queue_file.exists() or queue_file.stat().st_size == 0:
    print("File queue is empty")
    sys.exit(0)

# Read all messages
with open(queue_file, 'r') as f:
    lines = f.readlines()

db_config = read_database_config()

# Try to migrate each message
migrated = []
failed = []
invalid = []

print(f"Migrating {len(lines)} message(s) to RabbitMQ...")
print("")

for i, line in enumerate(lines, 1):
    line = line.strip()
    if not line:
        continue
    
    try:
        message = json.loads(line)
        
        # Extract required fields
        content_type = message.get("content_type")
        content_id = message.get("content_id")
        content_text = message.get("content_text")
        metadata = message.get("metadata", {})
        
        if not all([content_type, content_id, content_text]):
            print(f"  [{i}/{len(lines)}] ❌ Invalid message (missing required fields)")
            invalid.append(line)
            continue
        
        # Try to queue to RabbitMQ
        status = queue_vectorization(
            content_type=content_type,
            content_id=content_id,
            content_text=content_text,
            metadata=metadata,
            db_config=db_config
        )
        
        if status == "queued_to_rabbitmq":
            print(f"  [{i}/{len(lines)}] ✓ Migrated {content_type}:{content_id}")
            migrated.append(line)
        else:
            print(f"  [{i}/{len(lines)}] ⚠️  Failed to migrate {content_type}:{content_id} - {status}")
            failed.append(line)
    
    except json.JSONDecodeError as e:
        print(f"  [{i}/{len(lines)}] ❌ Invalid JSON: {e}")
        invalid.append(line)
    except Exception as e:
        print(f"  [{i}/{len(lines)}] ❌ Error: {e}")
        failed.append(line)

print("")
print(f"Migration complete:")
print(f"  ✓ Migrated: {len(migrated)}")
print(f"  ⚠️  Failed: {len(failed)}")
print(f"  ❌ Invalid: {len(invalid)}")

# Update file queue - remove migrated messages
if migrated or invalid:
    remaining = [l for l in lines if l.strip() not in migrated and l.strip() not in invalid]
    
    with open(queue_file, 'w') as f:
        f.writelines(remaining)
    
    print(f"")
    print(f"✓ Removed {len(migrated) + len(invalid)} message(s) from file queue")
    print(f"  Remaining in file queue: {len(remaining)} message(s)")

if failed:
    print(f"")
    print(f"⚠️  {len(failed)} message(s) failed to migrate and remain in file queue")
    print("   These may be retried later or processed by the file queue worker")

if migrated:
    sys.exit(0)
else:
    sys.exit(1)
PYTHON_EOF

# Run migration
"$PYTHON_CMD" /tmp/migrate_queue.py
EXIT_CODE=$?

rm -f /tmp/migrate_queue.py

exit $EXIT_CODE
