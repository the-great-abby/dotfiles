#!/bin/bash
#
# gtd-advice-queue-reset - Reset advice queue to clear stuck messages
#
# This script helps recover from the advice worker reconnection bug where
# messages get stuck in an infinite reprocessing loop.
#

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

show_help() {
    cat << EOF
Usage: gtd-advice-queue-reset [OPTIONS]

Reset the advice queue to clear stuck messages.

OPTIONS:
    --list           List current messages in queue (safe, no changes)
    --clear          Clear all messages from queue (⚠️  destructive)
    --restart        Restart the advice worker
    --full-reset     Clear queue AND restart worker
    --help           Show this help message

EXAMPLES:
    # Check queue status
    gtd-advice-queue-reset --list

    # Clear stuck messages
    gtd-advice-queue-reset --clear

    # Full recovery: clear queue and restart worker
    gtd-advice-queue-reset --full-reset

DESCRIPTION:
    This script helps recover from stuck messages in the advice queue.
    Use when the advice worker is reprocessing the same message repeatedly.

    The --list option shows you what's in the queue without making changes.
    The --clear option removes all messages (use if they're stuck).
    The --restart option restarts the worker (use after clearing queue).
    The --full-reset option does both clear + restart in one go.

EOF
}

list_queue() {
    echo -e "${BLUE}📋 Checking advice queue status...${NC}"
    echo ""
    
    # Check if RabbitMQ is running
    if ! docker ps | grep -q rabbitmq; then
        echo -e "${RED}❌ RabbitMQ container is not running${NC}"
        echo "   Start it with: docker start rabbitmq"
        exit 1
    fi
    
    # Get queue stats
    echo -e "${YELLOW}Queue: gtd_advice${NC}"
    docker exec rabbitmq rabbitmqadmin -f long -d 3 list queues name messages consumers | grep -A 10 gtd_advice || {
        echo -e "${RED}❌ Failed to query queue${NC}"
        exit 1
    }
    
    echo ""
    echo -e "${BLUE}💬 Recent worker activity:${NC}"
    if [[ -f /private/tmp/advice-worker.log ]]; then
        tail -20 /private/tmp/advice-worker.log | grep -E "(Processing|acknowledged|Connection lost)" || {
            echo "   (No recent activity found)"
        }
    else
        echo "   (No log file found)"
    fi
    
    echo ""
    echo -e "${BLUE}🔍 Checking for stuck messages...${NC}"
    if [[ -f /private/tmp/advice-worker.log ]]; then
        # Count how many times each message ID appears
        stuck_messages=$(grep "Processing:" /private/tmp/advice-worker.log | awk '{print $3}' | sort | uniq -c | sort -rn | head -5)
        if [[ -n "$stuck_messages" ]]; then
            echo "$stuck_messages" | while read count msg_id; do
                if [[ $count -gt 2 ]]; then
                    echo -e "   ${RED}⚠️  Message $msg_id processed $count times (STUCK!)${NC}"
                else
                    echo -e "   ${GREEN}✓ Message $msg_id processed $count times (normal)${NC}"
                fi
            done
        fi
    fi
}

clear_queue() {
    echo -e "${RED}⚠️  WARNING: This will clear ALL messages from the advice queue!${NC}"
    echo -e "${YELLOW}   Any pending advice requests will be lost.${NC}"
    echo ""
    
    # Show what will be deleted
    list_queue
    
    echo ""
    read -p "Are you sure you want to clear the queue? (yes/no): " -r
    if [[ ! $REPLY =~ ^[Yy][Ee][Ss]$ ]]; then
        echo "Cancelled."
        exit 0
    fi
    
    echo ""
    echo -e "${BLUE}🗑️  Clearing advice queue...${NC}"
    
    docker exec rabbitmq rabbitmqadmin purge queue name=gtd_advice && {
        echo -e "${GREEN}✅ Queue cleared successfully${NC}"
    } || {
        echo -e "${RED}❌ Failed to clear queue${NC}"
        exit 1
    }
}

restart_worker() {
    echo -e "${BLUE}🔄 Restarting advice worker...${NC}"
    
    # Check if gtd-advice-worker command exists
    if ! command -v gtd-advice-worker &> /dev/null; then
        echo -e "${RED}❌ gtd-advice-worker command not found${NC}"
        exit 1
    fi
    
    # Stop worker
    echo "   Stopping worker..."
    gtd-advice-worker stop || true
    
    # Wait a moment
    sleep 2
    
    # Start worker
    echo "   Starting worker..."
    gtd-advice-worker start
    
    # Wait for startup
    sleep 3
    
    # Check status
    echo ""
    echo -e "${BLUE}📊 Worker status:${NC}"
    gtd-advice-worker status
}

full_reset() {
    echo -e "${YELLOW}🔧 Full reset: clearing queue and restarting worker${NC}"
    echo ""
    
    clear_queue
    echo ""
    restart_worker
    
    echo ""
    echo -e "${GREEN}✅ Full reset complete!${NC}"
    echo ""
    echo "Monitor the worker with:"
    echo "  tail -f /private/tmp/advice-worker.log"
}

# Main
if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

case "${1:-}" in
    --list)
        list_queue
        ;;
    --clear)
        clear_queue
        ;;
    --restart)
        restart_worker
        ;;
    --full-reset)
        full_reset
        ;;
    --help|-h)
        show_help
        ;;
    *)
        echo -e "${RED}Unknown option: $1${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac

