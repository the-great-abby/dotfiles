#!/bin/bash
# GTD Vectorization Helper - Vectorize content after creation/update
# This script is called automatically after content is created/updated

# Source common GTD helpers
GTD_COMMON="$HOME/code/dotfiles/bin/gtd-common.sh"
if [[ ! -f "$GTD_COMMON" && -f "$HOME/code/personal/dotfiles/bin/gtd-common.sh" ]]; then
  GTD_COMMON="$HOME/code/personal/dotfiles/bin/gtd-common.sh"
fi
if [[ -f "$GTD_COMMON" ]]; then
  source "$GTD_COMMON"
fi

# Find config directory
GTD_CONFIG_DIR="$HOME/code/dotfiles/zsh"
if [[ ! -d "$GTD_CONFIG_DIR" ]]; then
  GTD_CONFIG_DIR="$HOME/code/personal/dotfiles/zsh"
fi

# Load GTD config to get computer mode and mode-specific settings
GTD_CONFIG_FILE="$GTD_CONFIG_DIR/.gtd_config"
if [[ ! -f "$GTD_CONFIG_FILE" ]]; then
  GTD_CONFIG_FILE="$HOME/code/personal/dotfiles/zsh/.gtd_config"
fi
if [[ ! -f "$GTD_CONFIG_FILE" ]]; then
  GTD_CONFIG_FILE="$HOME/.gtd_config"
fi

if [[ -f "$GTD_CONFIG_FILE" ]]; then
  # Source with error suppression
  set +e
  source "$GTD_CONFIG_FILE" 2>/dev/null || true
  set -e
fi

# Get current computer mode
current_mode="${GTD_COMPUTER_MODE:-home}"
mode_upper=$(echo "$current_mode" | tr '[:lower:]' '[:upper:]' | tr -d '[:space:]')
if [[ -z "$mode_upper" ]] || [[ ! "$mode_upper" =~ ^(HOME|WORK)$ ]]; then
  mode_upper="HOME"
fi

# Check for mode-specific GTD_VECTORIZATION_ENABLED first
mode_vectorization="GTD_VECTORIZATION_ENABLED_${mode_upper}"
if [[ -n "${!mode_vectorization:-}" ]]; then
  # Use mode-specific value
  GTD_VECTORIZATION_ENABLED="${!mode_vectorization}"
else
  # Fall back to database config
  if [[ -f "$GTD_CONFIG_DIR/.gtd_config_database" ]]; then
    set +e
    source "$GTD_CONFIG_DIR/.gtd_config_database" 2>/dev/null || true
    set -e
  elif [[ -f "$HOME/.gtd_config_database" ]]; then
    set +e
    source "$HOME/.gtd_config_database" 2>/dev/null || true
    set -e
  fi
fi

# Check if vectorization is enabled
if [[ "${GTD_VECTORIZATION_ENABLED:-true}" != "true" ]]; then
  exit 0  # Vectorization disabled, silently exit
fi

# Get arguments
CONTENT_TYPE="${1:-}"
CONTENT_ID="${2:-}"
CONTENT_TEXT="${3:-}"

if [[ -z "$CONTENT_TYPE" || -z "$CONTENT_ID" || -z "$CONTENT_TEXT" ]]; then
  # Silently exit if not enough arguments (don't spam errors)
  exit 0
fi

# Get Python command - prefer MCP virtualenv
PYTHON_CMD=""
MCP_VENV_PYTHON="$HOME/code/dotfiles/mcp/venv/bin/python3"
if [[ ! -f "$MCP_VENV_PYTHON" ]]; then
  MCP_VENV_PYTHON="$HOME/code/personal/dotfiles/mcp/venv/bin/python3"
fi

if [[ -f "$MCP_VENV_PYTHON" ]]; then
  PYTHON_CMD="$MCP_VENV_PYTHON"
elif command -v python3 &>/dev/null; then
  PYTHON_CMD="python3"
elif command -v python &>/dev/null; then
  PYTHON_CMD="python"
else
  # Silently exit if Python not found (don't spam errors)
  exit 0
fi

# Check if RabbitMQ is enabled for async processing
if [[ "${RABBITMQ_ENABLED:-false}" == "true" ]]; then
  # Use async mode - queue to RabbitMQ
  PYTHON_SCRIPT="$HOME/code/dotfiles/zsh/functions/gtd_vectorization.py"
  if [[ ! -f "$PYTHON_SCRIPT" ]]; then
    PYTHON_SCRIPT="$HOME/code/personal/dotfiles/zsh/functions/gtd_vectorization.py"
  fi
  
  if [[ -f "$PYTHON_SCRIPT" ]]; then
    # Queue for async processing (this returns immediately)
    "$PYTHON_CMD" "$PYTHON_SCRIPT" queue "$CONTENT_TYPE" "$CONTENT_ID" "$CONTENT_TEXT" 2>&1 | grep -v "^$" >&2 || true
    exit 0
  fi
fi

# Fallback to synchronous vectorization (original behavior)
PYTHON_SCRIPT="$HOME/code/dotfiles/zsh/functions/gtd_vectorization.py"
if [[ ! -f "$PYTHON_SCRIPT" ]]; then
  PYTHON_SCRIPT="$HOME/code/personal/dotfiles/zsh/functions/gtd_vectorization.py"
fi

if [[ ! -f "$PYTHON_SCRIPT" ]]; then
  # Silently exit if script not found (don't spam errors)
  exit 0
fi

# Vectorize content (run in background to not block)
# Only show output if there's an error
"$PYTHON_CMD" "$PYTHON_SCRIPT" vectorize "$CONTENT_TYPE" "$CONTENT_ID" "$CONTENT_TEXT" 2>&1 | grep -v "^$" >&2 || true

exit 0
