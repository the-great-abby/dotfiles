#!/bin/bash
# GTD Task Organizer - Clean up and organize your task backlog
# Helps with:
# - Finding tasks without projects
# - Suggesting which project tasks belong to (using AI)
# - Marking completed tasks
# - Bulk operations

# Source common GTD helpers
GTD_COMMON="$HOME/code/dotfiles/bin/gtd-common.sh"
if [[ ! -f "$GTD_COMMON" && -f "$HOME/code/personal/dotfiles/bin/gtd-common.sh" ]]; then
  GTD_COMMON="$HOME/code/personal/dotfiles/bin/gtd-common.sh"
fi
if [[ -f "$GTD_COMMON" ]]; then
  source "$GTD_COMMON"
else
  echo "Warning: gtd-common.sh not found. Some features may not work." >&2
fi

# Use common frontmatter helper
alias get_frontmatter_value='gtd_get_frontmatter_value'

# Define wrapper function (aliases don't always work in subshells)
get_frontmatter_value() {
  gtd_get_frontmatter_value "$@"
}

# Update frontmatter value
update_frontmatter_value() {
  local file="$1"
  local key="$2"
  local value="$3"
  
  if grep -q "^${key}:" "$file" 2>/dev/null; then
    if [[ "$OSTYPE" == "darwin"* ]]; then
      sed -i '' "s/^${key}:.*/${key}: ${value}/" "$file"
    else
      sed -i "s/^${key}:.*/${key}: ${value}/" "$file"
    fi
  else
    if [[ "$OSTYPE" == "darwin"* ]]; then
      sed -i '' "/^---$/a\\
${key}: ${value}
" "$file"
    else
      sed -i "/^---$/a\\${key}: ${value}" "$file"
    fi
  fi
}

# Find task file by ID
find_task_file() {
  local task_id="$1"
  
  # Search in tasks directory
  if [[ -d "$TASKS_PATH" ]]; then
    local task_file="${TASKS_PATH}/${task_id}.md"
    if [[ -f "$task_file" ]]; then
      echo "$task_file"
      return 0
    fi
  fi
  
  # Search in project directories
  if [[ -d "$PROJECTS_PATH" ]]; then
    while IFS= read -r task_file; do
      if [[ -f "$task_file" ]]; then
        echo "$task_file"
        return 0
      fi
    done < <(find "$PROJECTS_PATH" -name "${task_id}.md" -type f 2>/dev/null)
  fi
  
  return 1
}

# Get all tasks without projects
get_tasks_without_projects() {
  local tasks=()
  
  # Search in tasks directory (standalone tasks)
  if [[ -d "$TASKS_PATH" ]]; then
    while IFS= read -r task_file; do
      [[ ! -f "$task_file" ]] && continue
      local status=$(get_frontmatter_value "$task_file" "status")
      if [[ "$status" == "active" ]]; then
        local project=$(get_frontmatter_value "$task_file" "project")
        if [[ -z "$project" ]]; then
          tasks+=("$task_file")
        fi
      fi
    done < <(find "$TASKS_PATH" -name "*.md" -type f 2>/dev/null)
  fi
  
  printf '%s\0' "${tasks[@]}"
}

# Check cache for task analysis result
get_cached_task_analysis() {
  local task_id="$1"
  local cache_file="${GTD_BASE_DIR}/.task_analysis_cache.json"
  
  if [[ ! -f "$cache_file" ]]; then
    return 1
  fi
  
  # Use Python to read JSON cache (more reliable than bash JSON parsing)
  local python_cmd=""
  if declare -f gtd_get_mcp_python &>/dev/null; then
    python_cmd=$(gtd_get_mcp_python 2>/dev/null || echo "python3")
  else
    local mcp_dir="$HOME/code/dotfiles/mcp"
    if [[ ! -d "$mcp_dir" ]]; then
      mcp_dir="$HOME/code/personal/dotfiles/mcp"
    fi
    local venv_python="${mcp_dir}/venv/bin/python3"
    if [[ -f "$venv_python" ]]; then
      python_cmd="$venv_python"
    else
      python_cmd="python3"
    fi
  fi
  
  if command -v "$python_cmd" &>/dev/null; then
    local cached=$("$python_cmd" -c "
import json
import sys
from datetime import datetime, timedelta
from pathlib import Path

cache_file = Path('$cache_file')
if not cache_file.exists():
    sys.exit(1)

try:
    with open(cache_file) as f:
        cache = json.load(f)
    
    if '$task_id' in cache:
        entry = cache['$task_id']
        # Check if cache is still valid (not older than 30 days)
        cached_time = datetime.fromisoformat(entry.get('timestamp', '2000-01-01T00:00:00'))
        if (datetime.now() - cached_time).days < 30:
            print(entry.get('suggested_project', ''))
            sys.exit(0)
except:
    pass

sys.exit(1)
" 2>/dev/null)
    
    if [[ -n "$cached" ]]; then
      echo "$cached"
      return 0
    fi
  fi
  
  return 1
}

# Use AI to suggest which project a task belongs to
suggest_project_for_task() {
  local task_file="$1"
  local force_reanalyze="${2:-false}"
  
  if [[ ! -f "$task_file" ]]; then
    echo ""
    return 1
  fi
  
  local task_id=$(basename "$task_file" .md)
  
  # Check cache first (unless force_reanalyze is true)
  if [[ "$force_reanalyze" != "true" ]]; then
    local cached=$(get_cached_task_analysis "$task_id")
    if [[ -n "$cached" ]]; then
      echo "$cached"
      return 0
    fi
  fi
  
  # Get task details
  local task_name=$(head -20 "$task_file" | grep "^# " | head -1 | sed 's/^# //' || basename "$task_file" .md)
  # Remove any flags and their values that might be embedded in the title
  # First pass: remove --flag=value format
  task_name=$(echo "$task_name" | sed -E 's/[[:space:]]*--(context|priority|energy|project|repository|repo|recurring|frequency)=[^[:space:]]*[[:space:]]*/ /g')
  # Second pass: remove --flag value format (flag followed by space and value)
  task_name=$(echo "$task_name" | sed -E 's/[[:space:]]*--(context|priority|energy|project|repository|repo|recurring|frequency)[[:space:]]+[^[:space:]]*[[:space:]]*/ /g')
  task_name=$(echo "$task_name" | sed 's/[[:space:]]\{2,\}/ /g' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  local task_content=$(cat "$task_file")
  
  # Get list of existing projects
  local projects=()
  if [[ -d "$PROJECTS_PATH" ]]; then
    while IFS= read -r project_dir; do
      [[ ! -d "$project_dir" ]] && continue
      local project_name=$(basename "$project_dir")
      projects+=("$project_name")
    done < <(find "$PROJECTS_PATH" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
  fi
  
  # Build projects list for prompt
  local projects_list=""
  if [[ ${#projects[@]} -gt 0 ]]; then
    projects_list=$(printf '%s\n' "${projects[@]}" | tr '\n' ',' | sed 's/,$//')
  fi
  
  # Call AI helper if available
  local persona_helper="$HOME/code/dotfiles/mcp/gtd_advice_worker.py"
  if [[ ! -f "$persona_helper" ]]; then
    persona_helper="$HOME/code/personal/dotfiles/mcp/gtd_advice_worker.py"
  fi
  
  # Get the correct Python executable (venv if available)
  local python_cmd=""
  if declare -f gtd_get_mcp_python &>/dev/null; then
    python_cmd=$(gtd_get_mcp_python 2>/dev/null || echo "python3")
  else
    # Fallback: check for venv manually
    local mcp_dir="$HOME/code/dotfiles/mcp"
    if [[ ! -d "$mcp_dir" ]]; then
      mcp_dir="$HOME/code/personal/dotfiles/mcp"
    fi
    local venv_python="${mcp_dir}/venv/bin/python3"
    if [[ -f "$venv_python" ]]; then
      python_cmd="$venv_python"
    else
      python_cmd="python3"
    fi
  fi
  
  if [[ -f "$persona_helper" ]] && command -v "$python_cmd" &>/dev/null; then
    local prompt="Task: ${task_name}

Task content:
${task_content}

Available projects: ${projects_list}

Based on the task description, suggest which project this task belongs to. If it doesn't fit any existing project, suggest 'none' or a new project name.

Return ONLY the project name (or 'none'), nothing else."
    
    local system_prompt="You are a GTD organization assistant. Analyze tasks and suggest which project they belong to. Return only the project name, or 'none' if it doesn't fit any project."
    
    # Call AI with timeout (max 3 minutes per task for bulk operations)
    # This prevents the bulk organize from hanging on slow AI responses
    # If timeout occurs, we'll skip this task and continue with the next one
    local ai_timeout=180  # 3 minutes max per task
    local suggested_project=""
    local temp_output=$(mktemp)
    local temp_done=$(mktemp)
    local ai_pid=""
    
    # Always show timer for long-running AI calls
    if declare -f show_thinking_timer &>/dev/null; then
      # Start timer (parent_pid=0 means run until explicitly stopped)
      show_thinking_timer "Analyzing task" 2 0 >&2 &
      local timer_pid=$!
      
      # Run AI call in background - write to done file when complete
      (
        "$python_cmd" "$persona_helper" "david" "$prompt" 2>/dev/null > "$temp_output"
        echo "done" > "$temp_done"
      ) &
      ai_pid=$!
      
      # Use timeout mechanism that actually works
      (
        sleep "$ai_timeout"
        if [[ ! -f "$temp_done" ]]; then
          # Force kill the process and its children
          kill -9 "$ai_pid" 2>/dev/null || true
          pkill -9 -P "$ai_pid" 2>/dev/null || true
          # Also kill any gtd_advice_worker processes that might be stuck
          pkill -9 -f "gtd_advice_worker.py david" 2>/dev/null || true
        fi
      ) &
      local killer_pid=$!
      
      # Wait for AI call to finish, but with a maximum wait time
      local waited=0
      local max_wait=$((ai_timeout + 5))
      while [[ $waited -lt $max_wait ]]; do
        if ! kill -0 "$ai_pid" 2>/dev/null; then
          # Process finished
          break
        fi
        if [[ -f "$temp_done" ]]; then
          # Process finished normally
          break
        fi
        sleep 1
        ((waited++))
      done
      
      # Force kill if still running
      if kill -0 "$ai_pid" 2>/dev/null; then
        kill -9 "$ai_pid" 2>/dev/null || true
        pkill -9 -P "$ai_pid" 2>/dev/null || true
        pkill -9 -f "gtd_advice_worker.py david" 2>/dev/null || true
      fi
      
      # Kill the killer process (don't wait for it - it's in background)
      kill "$killer_pid" 2>/dev/null || true
      
      # Read result if available (process finished normally)
      if [[ -f "$temp_done" && -f "$temp_output" ]]; then
        suggested_project=$(cat "$temp_output" 2>/dev/null | grep -v '^[[:space:]]*$' | head -1 | tr -d '\n\r' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
      else
        # Timeout occurred or process was killed
        suggested_project="TIMEOUT"
      fi
      rm -f "$temp_output" "$temp_done" 2>/dev/null || true
      
      stop_thinking_timer $timer_pid 2>/dev/null || true
    else
      # Run AI call in background - write to done file when complete
      (
        "$python_cmd" "$persona_helper" "david" "$prompt" 2>/dev/null > "$temp_output"
        echo "done" > "$temp_done"
      ) &
      ai_pid=$!
      
      # Use timeout mechanism that actually works
      (
        sleep "$ai_timeout"
        if [[ ! -f "$temp_done" ]]; then
          # Force kill the process and its children
          kill -9 "$ai_pid" 2>/dev/null || true
          pkill -9 -P "$ai_pid" 2>/dev/null || true
          # Also kill any gtd_advice_worker processes that might be stuck
          pkill -9 -f "gtd_advice_worker.py david" 2>/dev/null || true
        fi
      ) &
      local killer_pid=$!
      
      # Wait for AI call to finish, but with a maximum wait time
      local waited=0
      local max_wait=$((ai_timeout + 5))
      while [[ $waited -lt $max_wait ]]; do
        if ! kill -0 "$ai_pid" 2>/dev/null; then
          # Process finished
          break
        fi
        if [[ -f "$temp_done" ]]; then
          # Process finished normally
          break
        fi
        sleep 1
        ((waited++))
      done
      
      # Force kill if still running
      if kill -0 "$ai_pid" 2>/dev/null; then
        kill -9 "$ai_pid" 2>/dev/null || true
        pkill -9 -P "$ai_pid" 2>/dev/null || true
        pkill -9 -f "gtd_advice_worker.py david" 2>/dev/null || true
      fi
      
      # Kill the killer process (don't wait for it - it's in background)
      kill "$killer_pid" 2>/dev/null || true
      
      # Read result if available (process finished normally)
      if [[ -f "$temp_done" && -f "$temp_output" ]]; then
        suggested_project=$(cat "$temp_output" 2>/dev/null | grep -v '^[[:space:]]*$' | head -1 | tr -d '\n\r' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
      else
        # Timeout occurred or process was killed
        suggested_project="TIMEOUT"
      fi
      rm -f "$temp_output" "$temp_done" 2>/dev/null || true
    fi
    
    # Handle timeout case
    if [[ "$suggested_project" == "TIMEOUT" ]]; then
      echo "TIMEOUT" >&2  # Log to stderr for debugging
      echo ""
      return 0
    fi
    
    # Clean up the suggestion (remove any blank/whitespace-only lines)
    suggested_project=$(echo "$suggested_project" | grep -v '^[[:space:]]*$' | head -1 | sed 's/^[^a-z0-9]*//' | sed 's/[^a-z0-9-]*$//')
    
    # Cache the result (if not timeout)
    if [[ -n "$suggested_project" && "$suggested_project" != "TIMEOUT" ]]; then
      # Cache using Python
      "$python_cmd" -c "
import json
from datetime import datetime
from pathlib import Path

cache_file = Path('${GTD_BASE_DIR}/.task_analysis_cache.json')
cache = {}
if cache_file.exists():
    try:
        with open(cache_file) as f:
            cache = json.load(f)
    except:
        pass

cache['$task_id'] = {
    'suggested_project': '$suggested_project',
    'timestamp': datetime.now().isoformat()
}

with open(cache_file, 'w') as f:
    json.dump(cache, f, indent=2)
" 2>/dev/null || true
    fi
    
    # Check if it matches an existing project
    if [[ -n "$suggested_project" && "$suggested_project" != "none" ]]; then
      for project in "${projects[@]}"; do
        if [[ "$project" == "$suggested_project" ]]; then
          echo "$suggested_project"
          return 0
        fi
      done
    fi
    
    # Only output if we have a non-blank suggestion
    if [[ -n "$suggested_project" ]]; then
      echo "$suggested_project"
    else
      echo ""
    fi
  else
    echo ""
  fi
}

# Check for completed background analysis
check_background_results() {
  local results_files=($(ls -t "${GTD_BASE_DIR}"/.bulk_organize_results_*.txt 2>/dev/null | head -1))
  if [[ ${#results_files[@]} -gt 0 ]]; then
    local latest_results="${results_files[0]}"
    local status_file="${latest_results/_results_/_status_}"
    
    if [[ -f "$status_file" ]] && grep -q "complete" "$status_file" 2>/dev/null; then
      return 0  # Has completed results
    fi
  fi
  return 1
}

# Review saved background analysis results
review_saved_results() {
  local results_files=($(ls -t "${GTD_BASE_DIR}"/.bulk_organize_results_*.txt 2>/dev/null))
  if [[ ${#results_files[@]} -eq 0 ]]; then
    echo ""
    echo "No saved analysis results found."
    echo ""
    echo "Press Enter to continue..."
    read
    return 1
  fi
  
  # Use most recent results file
  local results_file="${results_files[0]}"
  
  echo ""
  echo "Loading results from: $(basename "$results_file")"
  echo ""
  
  # Load suggestions from results file
  local suggestions=()
  local total=0
  while IFS= read -r line; do
    if [[ "$line" =~ ^TOTAL:([0-9]+)$ ]]; then
      total="${BASH_REMATCH[1]}"
    elif [[ "$line" =~ ^(.+)\|(.+)\|(.+)$ ]]; then
      suggestions+=("$line")
    fi
  done < "$results_file"
  
  if [[ ${#suggestions[@]} -eq 0 ]]; then
    echo "No suggestions found in results file."
    echo ""
    echo "Press Enter to continue..."
    read
    return 1
  fi
  
  echo "Found ${#suggestions[@]} suggestions to review."
  echo ""
  echo "Press Enter to start review..."
  read
  
  # Review the suggestions
  clear
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "📋 Review AI Suggestions"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  
  local accepted=0
  local skipped=0
  
  for suggestion in "${suggestions[@]}"; do
    IFS='|' read -r task_id task_name suggested_project <<< "$suggestion"
    
    local display_project=""
    if [[ "$suggested_project" == "none" ]]; then
      display_project="(no suggestion)"
    else
      display_project=$(echo "$suggested_project" | tr '-' ' ' | sed 's/\b\(.\)/\u\1/g')
    fi
    
    echo "Task: $task_name"
    echo "Suggested: $display_project"
    echo ""
    echo "  1) Accept suggestion"
    echo "  2) Choose different project"
    echo "  3) Skip"
    echo ""
    echo -n "Choose (1-3): "
    read choice
    
    case "$choice" in
      1)
        if [[ "$suggested_project" != "none" ]]; then
          if command -v gtd-task &>/dev/null; then
            gtd-task move "$task_id" "$suggested_project" >/dev/null 2>&1
            echo "✓ Assigned to: $display_project"
            ((accepted++))
          fi
        else
          echo "No suggestion to accept."
        fi
        ;;
      2)
        assign_task_to_project "$task_id"
        ((accepted++))
        ;;
      3)
        ((skipped++))
        ;;
      *)
        echo "Invalid choice, skipping..."
        ((skipped++))
        ;;
    esac
    
    echo ""
  done
  
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "✓ Bulk organization complete!"
  echo "  Accepted: $accepted"
  echo "  Skipped: $skipped"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "Press Enter to continue..."
  read
}

# Review suggestions from an array
review_suggestions_from_array() {
  local suggestions_ref="$1[@]"
  local suggestions=("${!suggestions_ref}")
  
  clear
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "📋 Review AI Suggestions"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  
  local accepted=0
  local skipped=0
  local timeout_count=0
  
  for suggestion in "${suggestions[@]}"; do
    IFS='|' read -r task_id task_name suggested_project <<< "$suggestion"
    
    local display_project=""
    if [[ "$suggested_project" == "none" ]]; then
      display_project="(no suggestion)"
    elif [[ "$suggested_project" == "timeout" ]]; then
      display_project="⏱️  (timeout - AI call took too long)"
      ((timeout_count++))
    else
      display_project=$(echo "$suggested_project" | tr '-' ' ' | sed 's/\b\(.\)/\u\1/g')
    fi
    
    echo "Task: $task_name"
    echo "Suggested: $display_project"
    echo ""
    
    if [[ "$suggested_project" == "timeout" ]]; then
      echo "  ⚠️  This task timed out during analysis (took > 3 minutes)"
      echo ""
      echo "  1) Retry analysis (may take a while)"
      echo "  2) Choose project manually"
      echo "  3) Skip"
      echo ""
      echo -n "Choose (1-3): "
      read choice
      
      case "$choice" in
        1)
          echo "Retrying analysis (this may take a few minutes)..."
          local retry_project=$(suggest_project_for_task "${GTD_BASE_DIR}/tasks/${task_id}.md" 2>/dev/null | grep -v '^[[:space:]]*$' | grep -v "TIMEOUT" | head -1 | tr -d '\n\r')
          if [[ -n "$retry_project" && "$retry_project" != "none" ]]; then
            if command -v gtd-task &>/dev/null; then
              gtd-task move "$task_id" "$retry_project" >/dev/null 2>&1
              local retry_display=$(echo "$retry_project" | tr '-' ' ' | sed 's/\b\(.\)/\u\1/g')
              echo "✓ Assigned to: $retry_display"
              ((accepted++))
            fi
          else
            echo "Still no suggestion. You can choose manually."
            assign_task_to_project "$task_id"
            ((accepted++))
          fi
          ;;
        2)
          assign_task_to_project "$task_id"
          ((accepted++))
          ;;
        3)
          ((skipped++))
          ;;
        *)
          echo "Invalid choice, skipping..."
          ((skipped++))
          ;;
      esac
    else
      echo "  1) Accept suggestion"
      echo "  2) Choose different project"
      echo "  3) Skip"
      echo ""
      echo -n "Choose (1-3): "
      read choice
      
      case "$choice" in
        1)
          if [[ "$suggested_project" != "none" ]]; then
            if command -v gtd-task &>/dev/null; then
              gtd-task move "$task_id" "$suggested_project" >/dev/null 2>&1
              echo "✓ Assigned to: $display_project"
              ((accepted++))
            fi
          else
            echo "No suggestion to accept."
          fi
          ;;
        2)
          assign_task_to_project "$task_id"
          ((accepted++))
          ;;
        3)
          ((skipped++))
          ;;
        *)
          echo "Invalid choice, skipping..."
          ((skipped++))
          ;;
      esac
    fi
    
    echo ""
  done
  
  if [[ $timeout_count -gt 0 ]]; then
    echo "Note: $timeout_count task(s) timed out during analysis."
    echo "You can retry them individually or assign projects manually."
    echo ""
  fi
  
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "✓ Bulk organization complete!"
  echo "  Accepted: $accepted"
  echo "  Skipped: $skipped"
  if [[ $timeout_count -gt 0 ]]; then
    echo "  Timeouts: $timeout_count"
  fi
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "Press Enter to continue..."
  read
}

# Main organize menu
organize_menu() {
  while true; do
    clear
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "📋 Task Organizer"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    
    # Check for completed background results
    if check_background_results; then
      echo "🔔 You have completed analysis results ready for review!"
      echo ""
    fi
    
    echo "What would you like to do?"
    echo ""
    echo "  1) Review tasks without projects"
    echo "  2) Clean up completed tasks"
    echo "  3) Bulk organize tasks (AI suggestions)"
    echo "  4) Suggest new projects from related tasks"
    if check_background_results; then
      echo "  5) Review saved analysis results"
      echo "  6) Exit"
      echo ""
      echo -n "Choose (1-6): "
      read choice
    else
      echo "  5) Exit"
      echo ""
      echo -n "Choose (1-5): "
      read choice
    fi
    
    case "$choice" in
      1)
        review_unassigned_tasks
        ;;
      2)
        cleanup_completed_tasks
        ;;
      3)
        bulk_organize_tasks
        ;;
      4)
        suggest_projects_from_tasks
        ;;
      5)
        if check_background_results; then
          review_saved_results
        else
          echo ""
          echo "Goodbye!"
          exit 0
        fi
        ;;
      6)
        echo ""
        echo "Goodbye!"
        exit 0
        ;;
      *)
        echo "Invalid choice. Press Enter to continue..."
        read
        ;;
    esac
  done
}

# Review tasks without projects
review_unassigned_tasks() {
  local tasks=()
  while IFS= read -r -d '' task; do
    tasks+=("$task")
  done < <(get_tasks_without_projects)
  
  if [[ ${#tasks[@]} -eq 0 ]]; then
    echo ""
    echo "✓ All tasks are assigned to projects!"
    echo ""
    echo "Press Enter to continue..."
    read
    return 0
  fi
  
  local current_idx=0
  while [[ $current_idx -lt ${#tasks[@]} ]]; do
    clear
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "📋 Tasks Without Projects ($((current_idx + 1))/${#tasks[@]})"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    
    local task_file="${tasks[$current_idx]}"
    local task_id=$(basename "$task_file" .md)
    local task_name=$(head -20 "$task_file" | grep "^# " | head -1 | sed 's/^# //' || echo "$task_id")
    # Remove any flags that might be embedded in the title
    task_name=$(echo "$task_name" | sed -E 's/[[:space:]]*--(context|priority|energy|project|repository|repo|recurring|frequency)(=[^[:space:]]*)?[[:space:]]*/ /g' | sed 's/[[:space:]]\{2,\}/ /g' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    local context=$(get_frontmatter_value "$task_file" "context")
    local energy=$(get_frontmatter_value "$task_file" "energy")
    local priority=$(get_frontmatter_value "$task_file" "priority")
    
    echo "Task: $task_name"
    echo "ID: $task_id"
    echo "Context: $context | Energy: $energy | Priority: $priority"
    echo ""
    echo "Content:"
    head -10 "$task_file" | tail -5
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "What would you like to do?"
    echo ""
    echo "  1) Assign to project"
    echo "  2) Get AI suggestion for project"
    echo "  3) Mark as completed"
    echo "  4) Skip (next task)"
    echo "  5) Back to menu"
    echo ""
    echo -n "Choose (1-5): "
    read action
    
    case "$action" in
      1)
        assign_task_to_project "$task_id"
        ;;
      2)
        suggest_and_assign "$task_id" "$task_file"
        ;;
      3)
        complete_task "$task_id"
        ;;
      4)
        ((current_idx++))
        continue
        ;;
      5)
        return 0
        ;;
      *)
        echo "Invalid choice. Press Enter to continue..."
        read
        ;;
    esac
    
    # Remove from array if completed or assigned
    if [[ "$action" == "1" || "$action" == "2" || "$action" == "3" ]]; then
      # Rebuild array without this task
      local new_tasks=()
      for t in "${tasks[@]}"; do
        if [[ "$t" != "$task_file" ]]; then
          new_tasks+=("$t")
        fi
      done
      tasks=("${new_tasks[@]}")
      # Don't increment index since we removed an item
      continue
    fi
    
    ((current_idx++))
  done
  
  echo ""
  echo "✓ Finished reviewing all unassigned tasks!"
  echo ""
  echo "Press Enter to continue..."
  read
}

# Assign task to project
assign_task_to_project() {
  local task_id="$1"
  
  # List available projects
  local projects=()
  if [[ -d "$PROJECTS_PATH" ]]; then
    while IFS= read -r project_dir; do
      [[ ! -d "$project_dir" ]] && continue
      local project_name=$(basename "$project_dir")
      projects+=("$project_name")
    done < <(find "$PROJECTS_PATH" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
  fi
  
  if [[ ${#projects[@]} -eq 0 ]]; then
    echo ""
    echo "No projects found. Create one first with: gtd-project create \"Project Name\""
    echo ""
    echo "Press Enter to continue..."
    read
    return 1
  fi
  
  echo ""
  echo "Available projects:"
  local idx=1
  for project in "${projects[@]}"; do
    local display_name=$(echo "$project" | tr '-' ' ' | sed 's/\b\(.\)/\u\1/g')
    echo "  $idx) $display_name"
    ((idx++))
  done
  echo "  $idx) Create new project"
  echo ""
  echo -n "Choose project (1-$idx): "
  read project_choice
  
  if [[ "$project_choice" == "$idx" ]]; then
    echo -n "New project name: "
    read new_project_name
    if [[ -n "$new_project_name" ]]; then
      if command -v gtd-project &>/dev/null; then
        gtd-project create "$new_project_name" >/dev/null 2>&1
        local project_slug=$(echo "$new_project_name" | tr ' ' '-' | tr '[:upper:]' '[:lower:]')
        if command -v gtd-task &>/dev/null; then
          gtd-task move "$task_id" "$project_slug" >/dev/null 2>&1
          echo "✓ Created project and assigned task!"
        fi
      fi
    fi
  elif [[ "$project_choice" =~ ^[0-9]+$ ]] && [[ $project_choice -ge 1 && $project_choice -le $((${#projects[@]})) ]]; then
    local project_idx=$((project_choice - 1))
    local selected_project="${projects[$project_idx]}"
    if command -v gtd-task &>/dev/null; then
      gtd-task move "$task_id" "$selected_project" >/dev/null 2>&1
      echo "✓ Assigned task to project: $selected_project"
    fi
  else
    echo "Invalid choice."
  fi
  
  echo ""
  echo "Press Enter to continue..."
  read
}

# Suggest and assign using AI
suggest_and_assign() {
  local task_id="$1"
  local task_file="$2"
  
  echo ""
  echo "🤔 Analyzing task with AI..."
  echo ""
  
  local suggested_project=$(suggest_project_for_task "$task_file")
  
  if [[ -z "$suggested_project" || "$suggested_project" == "none" ]]; then
    echo "AI couldn't find a good project match. Would you like to assign manually?"
    echo -n "(y/N): "
    read assign_manually
    if [[ "$assign_manually" =~ ^[Yy]$ ]]; then
      assign_task_to_project "$task_id"
    fi
    return 0
  fi
  
  # Show suggestion
  local display_name=$(echo "$suggested_project" | tr '-' ' ' | sed 's/\b\(.\)/\u\1/g')
  echo "💡 Suggested project: $display_name"
  echo ""
  echo "Would you like to:"
  echo "  1) Assign to this project"
  echo "  2) Choose a different project"
  echo "  3) Skip"
  echo ""
  echo -n "Choose (1-3): "
  read choice
  
  case "$choice" in
    1)
      if command -v gtd-task &>/dev/null; then
        gtd-task move "$task_id" "$suggested_project" >/dev/null 2>&1
        echo "✓ Assigned to project: $display_name"
      fi
      ;;
    2)
      assign_task_to_project "$task_id"
      ;;
    3)
      echo "Skipped."
      ;;
    *)
      echo "Invalid choice."
      ;;
  esac
  
  echo ""
  echo "Press Enter to continue..."
  read
}

# Complete a task
complete_task() {
  local task_id="$1"
  
  if command -v gtd-task &>/dev/null; then
    gtd-task complete "$task_id" >/dev/null 2>&1
    echo "✓ Task marked as completed!"
  else
    echo "❌ gtd-task command not found"
  fi
  
  echo ""
  echo "Press Enter to continue..."
  read
}

# Clean up completed tasks
cleanup_completed_tasks() {
  echo ""
  echo "This will help you review and clean up tasks that might already be completed."
  echo ""
  echo "Note: This reviews active tasks - if you've completed something but forgot"
  echo "to mark it done, you can mark it here."
  echo ""
  echo "Press Enter to continue..."
  read
  
  # Get all active tasks
  local tasks=()
  if [[ -d "$TASKS_PATH" ]]; then
    while IFS= read -r task_file; do
      [[ ! -f "$task_file" ]] && continue
      local status=$(get_frontmatter_value "$task_file" "status")
      if [[ "$status" == "active" ]]; then
        tasks+=("$task_file")
      fi
    done < <(find "$TASKS_PATH" -name "*.md" -type f 2>/dev/null)
  fi
  
  if [[ ${#tasks[@]} -eq 0 ]]; then
    echo ""
    echo "No active tasks found in tasks directory."
    echo ""
    echo "Press Enter to continue..."
    read
    return 0
  fi
  
  local current_idx=0
  while [[ $current_idx -lt ${#tasks[@]} ]]; do
    clear
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "🧹 Clean Up Tasks ($((current_idx + 1))/${#tasks[@]})"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    
    local task_file="${tasks[$current_idx]}"
    local task_id=$(basename "$task_file" .md)
    local task_name=$(head -20 "$task_file" | grep "^# " | head -1 | sed 's/^# //' || echo "$task_id")
    # Remove any flags that might be embedded in the title
    task_name=$(echo "$task_name" | sed -E 's/[[:space:]]*--(context|priority|energy|project|repository|repo|recurring|frequency)(=[^[:space:]]*)?[[:space:]]*/ /g' | sed 's/[[:space:]]\{2,\}/ /g' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    local context=$(get_frontmatter_value "$task_file" "context")
    local project=$(get_frontmatter_value "$task_file" "project")
    
    echo "Task: $task_name"
    echo "ID: $task_id"
    if [[ -n "$project" ]]; then
      echo "Project: $project"
    fi
    echo ""
    echo "Content:"
    head -15 "$task_file" | tail -10
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "Is this task already completed?"
    echo ""
    echo "  1) Yes, mark as completed"
    echo "  2) No, keep active"
    echo "  3) Skip (next task)"
    echo "  4) Back to menu"
    echo ""
    echo -n "Choose (1-4): "
    read action
    
    case "$action" in
      1)
        complete_task "$task_id"
        # Remove from array
        local new_tasks=()
        for t in "${tasks[@]}"; do
          if [[ "$t" != "$task_file" ]]; then
            new_tasks+=("$t")
          fi
        done
        tasks=("${new_tasks[@]}")
        continue
        ;;
      2)
        ((current_idx++))
        continue
        ;;
      3)
        ((current_idx++))
        continue
        ;;
      4)
        return 0
        ;;
      *)
        echo "Invalid choice. Press Enter to continue..."
        read
        ;;
    esac
  done
  
  echo ""
  echo "✓ Finished reviewing tasks!"
  echo ""
  echo "Press Enter to continue..."
  read
}

# Suggest new projects from related tasks
suggest_projects_from_tasks() {
  echo ""
  echo "This will analyze all unassigned tasks and group related ones together."
  echo "For groups that don't match existing projects, it will suggest creating new projects."
  echo ""
  echo "💡 This will run in the background - you'll be notified when complete!"
  echo ""
  echo "Press Enter to continue..."
  read
  
  # Get all unassigned tasks
  local tasks=()
  while IFS= read -r -d '' task; do
    tasks+=("$task")
  done < <(get_tasks_without_projects)
  
  if [[ ${#tasks[@]} -eq 0 ]]; then
    echo ""
    echo "✓ All tasks are assigned to projects!"
    echo ""
    echo "Press Enter to continue..."
    read
    return 0
  fi
  
  echo ""
  echo "Queuing analysis of ${#tasks[@]} unassigned tasks..."
  echo ""
  
  # Get Python command
  local python_cmd=""
  if declare -f gtd_get_mcp_python &>/dev/null; then
    python_cmd=$(gtd_get_mcp_python 2>/dev/null || echo "python3")
  else
    local mcp_dir="$HOME/code/dotfiles/mcp"
    if [[ ! -d "$mcp_dir" ]]; then
      mcp_dir="$HOME/code/personal/dotfiles/mcp"
    fi
    local venv_python="${mcp_dir}/venv/bin/python3"
    if [[ -f "$venv_python" ]]; then
      python_cmd="$venv_python"
    else
      python_cmd="python3"
    fi
  fi
  
  # Collect task IDs
  local task_ids=()
  for task_file in "${tasks[@]}"; do
    local task_id=$(basename "$task_file" .md)
    task_ids+=("$task_id")
  done
  
  # Queue the analysis job
  local queue_result=$("$python_cmd" -c "
import sys
import json
sys.path.insert(0, '$(dirname "$0")/../mcp')
sys.path.insert(0, '$HOME/code/dotfiles/mcp')
from gtd_mcp_server import queue_project_suggestions

task_ids = $(printf '%s\n' "${task_ids[@]}" | "$python_cmd" -c "import sys, json; print(json.dumps([line.strip() for line in sys.stdin if line.strip()]))")
status = queue_project_suggestions(task_ids)
print(status)
" 2>&1)
  
  if [[ "$queue_result" =~ "queued_to_rabbitmq" || "$queue_result" =~ "queued_to_file" ]]; then
    echo "✅ Analysis queued! Processing ${#task_ids[@]} tasks in the background."
    echo ""
    echo "You'll see results in the wizard when complete, or run:"
    echo "  gtd-task-organize"
    echo ""
    echo "And select 'Review project suggestion results'"
    echo ""
  else
    echo "⚠️  Failed to queue analysis: $queue_result"
    echo ""
  fi
  
  echo "Press Enter to continue..."
  read
  return 0
  
  # Get existing projects
  local projects=()
  if [[ -d "$PROJECTS_PATH" ]]; then
    while IFS= read -r project_dir; do
      [[ ! -d "$project_dir" ]] && continue
      local project_name=$(basename "$project_dir")
      projects+=("$project_name")
    done < <(find "$PROJECTS_PATH" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)
  fi
  
  # Create temp file for projects list
  local temp_projects=$(mktemp)
  printf '%s\n' "${projects[@]}" > "$temp_projects"
  
  # Call Python script to analyze and group tasks
  local temp_results=$(mktemp)
  local temp_script=$(mktemp)
  
  if declare -f show_thinking_timer &>/dev/null; then
    show_thinking_timer "Analyzing task relationships" 2 0 >&2 &
    local timer_pid=$!
  fi
  
  # Write Python script to temp file
  cat > "$temp_script" << 'PYEOF'
import sys
import json
import re
from pathlib import Path
from collections import defaultdict

# Get file paths from command line
temp_tasks = sys.argv[1]
temp_projects = sys.argv[2]

# Add paths for imports
sys.path.insert(0, str(Path.home() / 'code' / 'dotfiles' / 'mcp'))
sys.path.insert(0, str(Path.home() / 'code' / 'dotfiles' / 'zsh' / 'functions'))

try:
    from gtd_mcp_server import call_fast_ai, GTD_BASE_DIR
    from gtd_vectorization import search_similar, generate_embedding
    VECTOR_AVAILABLE = True
except ImportError:
    VECTOR_AVAILABLE = False
    try:
        from gtd_mcp_server import call_fast_ai, GTD_BASE_DIR
    except ImportError:
        call_fast_ai = None
        GTD_BASE_DIR = Path.home() / "Documents" / "gtd"

# Read tasks
tasks = []
try:
    with open(temp_tasks, 'r') as f:
        for line in f:
            parts = line.strip().split('|', 2)
            if len(parts) >= 2:
                tasks.append({
                    'id': parts[0],
                    'name': parts[1],
                    'content': parts[2] if len(parts) > 2 else ''
                })
except Exception as e:
    print(json.dumps({'error': f'Failed to read tasks: {e}', 'groups': []}))
    sys.exit(1)

# Read existing projects
existing_projects = []
try:
    with open(temp_projects, 'r') as f:
        existing_projects = [line.strip() for line in f if line.strip()]
except:
    pass
PYEOF

  # Continue with the rest of the Python script
  cat >> "$temp_script" << 'PYEOF'

if not tasks:
    print(json.dumps({'groups': []}))
    sys.exit(0)

# Group tasks by similarity
# Strategy: Use AI to group related tasks, then suggest project names
groups = []

# First, try to use vector similarity if available
if VECTOR_AVAILABLE and len(tasks) > 1:
    # Use vector search to find similar tasks
    processed = set()
    for task in tasks:
        if task['id'] in processed:
            continue
        
        # Search for similar tasks
        query_text = f"{task['name']} {task['content'][:200]}"
        try:
            similar = search_similar(query_text, content_type='task', limit=10, threshold=0.6)
            # Find tasks in our list that match
            group = [task]
            for result in similar:
                result_id = result.get('content_id', '')
                # Check if this task is in our unassigned list
                for t in tasks:
                    if t['id'] == result_id and t['id'] not in processed:
                        group.append(t)
                        processed.add(t['id'])
                        break
            processed.add(task['id'])
            
            if len(group) > 1:
                groups.append(group)
        except:
            # Vector search failed, fall back to AI grouping
            pass

# If vector search didn't work or we have ungrouped tasks, use AI
if not groups or len(processed) < len(tasks):
    # Use AI to group remaining tasks
    ungrouped = [t for t in tasks if t['id'] not in processed] if 'processed' in locals() else tasks
    
    if ungrouped and call_fast_ai:
        # Create prompt for AI to group tasks
        tasks_text = "\n".join([f"- {t['name']}: {t['content'][:100]}" for t in ungrouped[:20]])  # Limit to 20 for prompt
        
        prompt = f"""Analyze these unassigned tasks and group them by topic/theme. Tasks that are related should be grouped together.

Tasks:
{tasks_text}

Return a JSON array where each group is an object with:
- "task_ids": array of task IDs (use the task name as identifier, I'll map it)
- "theme": brief description of what these tasks have in common
- "suggested_project_name": a short project name (kebab-case, like "work-efficiency" or "home-improvement")

Example:
[
  {{
    "task_ids": ["Task 1 name", "Task 2 name"],
    "theme": "Tasks related to morning routines",
    "suggested_project_name": "morning-routine-optimization"
  }}
]

Only group tasks that are clearly related. If a task doesn't fit with others, it can be in its own group.
Return ONLY the JSON array, no other text."""

        try:
            response = call_fast_ai(prompt, "You are a GTD organization assistant. Group related tasks and suggest project names.")
            
            # Extract JSON from response
            json_match = re.search(r'\[.*?\]', response, re.DOTALL)
            if json_match:
                ai_groups = json.loads(json_match.group())
                
                # Map task names to IDs
                name_to_id = {t['name']: t['id'] for t in ungrouped}
                
                for ai_group in ai_groups:
                    task_ids_in_group = []
                    for task_name in ai_group.get('task_ids', []):
                        # Try to find matching task
                        for t in ungrouped:
                            if task_name.lower() in t['name'].lower() or t['name'].lower() in task_name.lower():
                                if t['id'] not in task_ids_in_group:
                                    task_ids_in_group.append(t['id'])
                                    break
                    
                    if task_ids_in_group:
                        group_tasks = [t for t in ungrouped if t['id'] in task_ids_in_group]
                        groups.append({
                            'tasks': group_tasks,
                            'theme': ai_group.get('theme', ''),
                            'suggested_name': ai_group.get('suggested_project_name', '')
                        })
        except Exception as e:
            # AI grouping failed, create individual groups
            pass

# If still no groups, create individual groups
if not groups:
    for task in tasks:
        groups.append({
            'tasks': [task],
            'theme': task['name'],
            'suggested_name': ''
        })

# For each group, check if suggested project already exists
# and suggest a project name if needed
result_groups = []
for group in groups:
    tasks_in_group = group.get('tasks', group) if isinstance(group, dict) else group
    theme = group.get('theme', '') if isinstance(group, dict) else ''
    suggested_name = group.get('suggested_name', '') if isinstance(group, dict) else ''
    
    # If no suggested name, generate one
    if not suggested_name and call_fast_ai:
        task_names = [t['name'] for t in tasks_in_group]
        prompt = f"""Based on these related tasks, suggest a short project name (kebab-case, 2-4 words max):

Tasks:
{chr(10).join(f"- {name}" for name in task_names[:5])}

Theme: {theme if theme else 'Various related tasks'}

Return ONLY the project name in kebab-case, nothing else. Example: "work-efficiency" or "home-maintenance"."""
        
        try:
            suggested_name = call_fast_ai(prompt, "You are a GTD organization assistant. Suggest concise project names.").strip().lower()
            # Clean up: remove quotes, convert to kebab-case
            suggested_name = re.sub(r'[^a-z0-9-]', '', suggested_name.replace(' ', '-'))
        except:
            # Generate simple name from theme
            suggested_name = re.sub(r'[^a-z0-9-]', '', theme.lower().replace(' ', '-'))[:30]
    
    # Check if project already exists
    project_exists = suggested_name in existing_projects
    
    result_groups.append({
        'task_ids': [t['id'] for t in tasks_in_group],
        'task_names': [t['name'] for t in tasks_in_group],
        'theme': theme,
        'suggested_project_name': suggested_name,
        'project_exists': project_exists
    })

print(json.dumps({'groups': result_groups}, indent=2))
PYEOF

  # Execute the Python script
  "$python_cmd" "$temp_script" "$temp_tasks" "$temp_projects" 2>/dev/null > "$temp_results"
  local python_exit=$?
  
  rm -f "$temp_script" 2>/dev/null || true

  if declare -f stop_thinking_timer &>/dev/null && [[ -n "$timer_pid" ]]; then
    stop_thinking_timer $timer_pid 2>/dev/null || true
  fi
  
  # Check if we got results
  if [[ ! -f "$temp_results" ]] || [[ ! -s "$temp_results" ]]; then
    echo "⚠️  Analysis failed. Please try again."
    rm -f "$temp_tasks" "$temp_projects" "$temp_results" 2>/dev/null || true
    echo ""
    echo "Press Enter to continue..."
    read
    return 1
  fi
  
  # Parse results
  local groups_json=$(cat "$temp_results")
  rm -f "$temp_tasks" "$temp_projects" "$temp_results" 2>/dev/null || true
  
  # Display groups and let user create projects
  clear
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "💡 Suggested Projects from Related Tasks"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  
  # Parse JSON and show groups
  local group_count=$("$python_cmd" -c "
import json
import sys
groups = json.loads('''$groups_json''')
print(len(groups.get('groups', [])))
" 2>/dev/null)
  
  if [[ "$group_count" -eq 0 ]]; then
    echo "No related task groups found."
    echo ""
    echo "Press Enter to continue..."
    read
    return 0
  fi
  
  echo "Found $group_count group(s) of related tasks:"
  echo ""
  
  # Show each group
  local idx=1
  "$python_cmd" -c "
import json
import sys

groups_data = json.loads('''$groups_json''')
groups = groups_data.get('groups', [])

for i, group in enumerate(groups, 1):
    print(f\"Group {i}:\")
    print(f\"  Theme: {group.get('theme', 'N/A')}\")
    print(f\"  Suggested Project: {group.get('suggested_project_name', 'N/A')}\")
    if group.get('project_exists'):
        print(f\"  ⚠️  Project already exists\")
    print(f\"  Tasks ({len(group.get('task_ids', []))}):\")
    for task_name in group.get('task_names', [])[:5]:
        print(f\"    - {task_name}\")
    if len(group.get('task_names', [])) > 5:
        print(f\"    ... and {len(group.get('task_names', [])) - 5} more\")
    print()
" 2>/dev/null
  
  echo ""
  echo "What would you like to do?"
  echo ""
  echo "  1) Create projects for all suggestions"
  echo "  2) Review and create projects one by one"
  echo "  3) Skip"
  echo ""
  echo -n "Choose (1-3): "
  read choice
  
  case "$choice" in
    1)
      # Create all projects
      "$python_cmd" -c "
import json
import sys
import subprocess
from pathlib import Path

groups_data = json.loads('''$groups_json''')
groups = groups_data.get('groups', [])

created = 0
for group in groups:
    project_name = group.get('suggested_project_name', '')
    if not project_name or group.get('project_exists'):
        continue
    
    # Create project using gtd-project command
    try:
        result = subprocess.run(['gtd-project', 'create', project_name], 
                              capture_output=True, text=True, timeout=10)
        if result.returncode == 0:
            created += 1
            print(f\"✓ Created project: {project_name}\")
            
            # Move tasks to project
            for task_id in group.get('task_ids', []):
                try:
                    subprocess.run(['gtd-task', 'move', task_id, project_name],
                                 capture_output=True, timeout=5)
                except:
                    pass
        else:
            print(f\"⚠️  Failed to create: {project_name}\")
    except Exception as e:
        print(f\"⚠️  Error creating {project_name}: {e}\")

print(f\"\\n✓ Created {created} project(s) and assigned tasks.\")
" 2>/dev/null
      ;;
    2)
      # Review one by one
      "$python_cmd" -c "
import json
import sys
import subprocess

groups_data = json.loads('''$groups_json''')
groups = groups_data.get('groups', [])

for i, group in enumerate(groups, 1):
    project_name = group.get('suggested_project_name', '')
    theme = group.get('theme', '')
    task_count = len(group.get('task_ids', []))
    
    if group.get('project_exists'):
        print(f\"\\nGroup {i}: Project '{project_name}' already exists. Skipping.\")
        continue
    
    if not project_name:
        print(f\"\\nGroup {i}: No project name suggested. Skipping.\")
        continue
    
    print(f\"\\n{'='*60}\")
    print(f\"Group {i} of {len(groups)}\")
    print(f\"Theme: {theme}\")
    print(f\"Suggested Project: {project_name}\")
    print(f\"Tasks ({task_count}):\")
    for task_name in group.get('task_names', [])[:10]:
        print(f\"  - {task_name}\")
    if task_count > 10:
        print(f\"  ... and {task_count - 10} more\")
    print()
    print(\"Create this project? (y/N): \", end='', flush=True)
    
    response = input().strip().lower()
    if response == 'y':
        try:
            result = subprocess.run(['gtd-project', 'create', project_name],
                                  capture_output=True, text=True, timeout=10)
            if result.returncode == 0:
                print(f\"✓ Created project: {project_name}\")
                
                # Move tasks
                moved = 0
                for task_id in group.get('task_ids', []):
                    try:
                        subprocess.run(['gtd-task', 'move', task_id, project_name],
                                     capture_output=True, timeout=5)
                        moved += 1
                    except:
                        pass
                print(f\"✓ Moved {moved} task(s) to project\")
            else:
                print(f\"⚠️  Failed to create project\")
        except Exception as e:
            print(f\"⚠️  Error: {e}\")
    else:
        print(\"Skipped.\")
" 2>/dev/null
      ;;
    3)
      echo "Skipped."
      ;;
  esac
  
  echo ""
  echo "Press Enter to continue..."
  read
}

# Bulk organize tasks with AI suggestions (background version)
bulk_organize_tasks_background() {
  local tasks=()
  while IFS= read -r -d '' task; do
    tasks+=("$task")
  done < <(get_tasks_without_projects)
  
  if [[ ${#tasks[@]} -eq 0 ]]; then
    return 0
  fi
  
  # Create results file
  local results_file="${GTD_BASE_DIR}/.bulk_organize_results_$(date +%Y%m%d%H%M%S).json"
  local status_file="${GTD_BASE_DIR}/.bulk_organize_status_$(date +%Y%m%d%H%M%S).txt"
  
  # Write initial status
  echo "Starting analysis of ${#tasks[@]} tasks..." > "$status_file"
  echo "0" >> "$status_file"  # Progress counter
  
  # Collect suggestions in background
  local suggestions=()
  local idx=0
  for task_file in "${tasks[@]}"; do
    ((idx++))
    local task_id=$(basename "$task_file" .md)
    local task_name=$(head -20 "$task_file" | grep "^# " | head -1 | sed 's/^# //' || echo "$task_id")
    # Remove any flags that might be embedded in the title
    task_name=$(echo "$task_name" | sed -E 's/[[:space:]]*--(context|priority|energy|project|repository|repo|recurring|frequency)(=[^[:space:]]*)?[[:space:]]*/ /g' | sed 's/[[:space:]]\{2,\}/ /g' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    
    # Update status
    echo "[$idx/${#tasks[@]}] Analyzing: $task_name" > "$status_file"
    echo "$idx" >> "$status_file"
    
    local suggested_project=$(suggest_project_for_task "$task_file")
    
    if [[ -n "$suggested_project" && "$suggested_project" != "none" ]]; then
      suggestions+=("$task_id|$task_name|$suggested_project")
    else
      suggestions+=("$task_id|$task_name|none")
    fi
  done
  
  # Save results to JSON file
  {
    echo "{"
    echo "  \"total_tasks\": ${#tasks[@]},"
    echo "  \"analyzed_at\": \"$(date -Iseconds)\","
    echo "  \"suggestions\": ["
    local first=true
    for suggestion in "${suggestions[@]}"; do
      if [[ "$first" == "true" ]]; then
        first=false
      else
        echo ","
      fi
      IFS='|' read -r task_id task_name suggested_project <<< "$suggestion"
      echo "    {"
      echo "      \"task_id\": \"$task_id\","
      echo "      \"task_name\": $(echo "$task_name" | python3 -c "import sys, json; print(json.dumps(sys.stdin.read().strip()))"),"
      echo "      \"suggested_project\": \"$suggested_project\""
      echo -n "    }"
    done
    echo ""
    echo "  ]"
    echo "}"
  } > "$results_file"
  
  # Mark as complete
  echo "✓ Analysis complete! Results saved." > "$status_file"
  echo "${#tasks[@]}" >> "$status_file"
  
  # Send notification if available
  if command -v gtd-notify &>/dev/null; then
    gtd-notify "Task Organizer" "Analysis complete: ${#tasks[@]} tasks analyzed" "Ready for review" "Glass" 2>/dev/null || true
  fi
  
  echo "$results_file"
}

# Bulk organize tasks with AI suggestions
bulk_organize_tasks() {
  echo ""
  echo "This will analyze all unassigned tasks and suggest projects for them."
  echo "You can then review and accept/reject suggestions in bulk."
  echo ""
  echo "Options:"
  echo "  1) Queue via RabbitMQ/worker (recommended for many tasks)"
  echo "  2) Run in background (legacy, direct processing)"
  echo "  3) Run now (blocks until complete)"
  echo ""
  echo -n "Choose (1-3): "
  read run_mode
  
  local tasks=()
  while IFS= read -r -d '' task; do
    tasks+=("$task")
  done < <(get_tasks_without_projects)
  
  if [[ ${#tasks[@]} -eq 0 ]]; then
    echo ""
    echo "✓ All tasks are assigned to projects!"
    echo ""
    echo "Press Enter to continue..."
    read
    return 0
  fi
  
  # Extract task IDs
  local task_ids=()
  for task_file in "${tasks[@]}"; do
    local task_id=$(basename "$task_file" .md)
    task_ids+=("$task_id")
  done
  
  if [[ "$run_mode" == "1" ]]; then
    # Queue via RabbitMQ/worker
    echo ""
    echo "🚀 Queueing ${#tasks[@]} tasks for background processing..."
    echo ""
    
    # Get Python command
    local python_cmd=""
    if declare -f gtd_get_mcp_python &>/dev/null; then
      python_cmd=$(gtd_get_mcp_python 2>/dev/null || echo "python3")
    else
      local mcp_dir="$HOME/code/dotfiles/mcp"
      if [[ ! -d "$mcp_dir" ]]; then
        mcp_dir="$HOME/code/personal/dotfiles/mcp"
      fi
      local venv_python="${mcp_dir}/venv/bin/python3"
      if [[ -f "$venv_python" ]]; then
        python_cmd="$venv_python"
      else
        python_cmd="python3"
      fi
    fi
    
    # Queue the job
    # First, create a temp file with task IDs as JSON
    local temp_task_ids=$(mktemp)
    printf '%s\n' "${task_ids[@]}" | "$python_cmd" -c "import sys, json; print(json.dumps([line.strip() for line in sys.stdin if line.strip()]))" > "$temp_task_ids"
    
    local queue_result=$("$python_cmd" -c "
import sys
import json
from pathlib import Path

sys.path.insert(0, str(Path.home() / 'code' / 'dotfiles' / 'mcp'))
try:
    from gtd_mcp_server import queue_task_organization
    
    with open('$temp_task_ids', 'r') as f:
        task_ids = json.load(f)
    
    result = queue_task_organization(task_ids, force_reanalyze=False)
    print(result)
except Exception as e:
    print(f'error: {e}')
" 2>/dev/null)
    
    rm -f "$temp_task_ids" 2>/dev/null || true
    
    if [[ "$queue_result" == "queued_to_rabbitmq" ]]; then
      echo "✓ Tasks queued to RabbitMQ. Worker will process them in the background."
      echo ""
      echo "You can check status via:"
      echo "  • gtd-wizard → System status → Background Worker Status"
      echo "  • tail -f \${GTD_BASE_DIR}/.bulk_organize_status_*.txt"
      echo ""
      echo "Results will be saved when complete."
    elif [[ "$queue_result" == "queued_to_file" ]]; then
      echo "✓ Tasks queued to file. Worker will process them when running."
      echo ""
      echo "To start the worker:"
      echo "  cd ~/code/dotfiles/mcp"
      echo "  python3 gtd_task_organize_worker.py file"
      echo ""
      echo "Or check if worker is already running:"
      echo "  pgrep -f gtd_task_organize_worker.py"
    else
      echo "⚠️  Queueing failed: $queue_result"
      echo "Falling back to direct processing..."
      run_mode="2"  # Fall back to background mode
    fi
    
    if [[ "$run_mode" != "1" ]]; then
      # Fall through to background processing
      :
    else
      echo ""
      echo "Press Enter to continue..."
      read
      return 0
    fi
  fi
  
  if [[ "$run_mode" == "2" ]]; then
    # Run in background
    echo ""
    echo "🚀 Starting background analysis of ${#tasks[@]} tasks..."
    echo ""
    
    # Create unique file names
    local timestamp=$(date +%Y%m%d%H%M%S)
    local results_file="${GTD_BASE_DIR}/.bulk_organize_results_${timestamp}.txt"
    local status_file="${GTD_BASE_DIR}/.bulk_organize_status_${timestamp}.txt"
    local log_file="${GTD_BASE_DIR}/.bulk_organize_${timestamp}.log"
    
    # Start background process with nohup
    (
      # Write initial status (ensure no blank lines)
      {
        echo "Starting analysis of ${#tasks[@]} tasks..."
        echo "0"
      } > "$status_file"
      
      local suggestions=()
      local idx=0
      for task_file in "${tasks[@]}"; do
        ((idx++))
        local task_id=$(basename "$task_file" .md)
        local task_name=$(head -20 "$task_file" | grep "^# " | head -1 | sed 's/^# //' || echo "$task_id")
        
        # Clean task name (remove flags and their values, newlines and extra whitespace)
        # Remove any flags that might be embedded in the title (handles both --flag=value and --flag value formats)
        # First pass: remove --flag=value format
        task_name=$(echo "$task_name" | sed -E 's/[[:space:]]*--(context|priority|energy|project|repository|repo|recurring|frequency)=[^[:space:]]*[[:space:]]*/ /g')
        # Second pass: remove --flag value format (flag followed by space and value)
        task_name=$(echo "$task_name" | sed -E 's/[[:space:]]*--(context|priority|energy|project|repository|repo|recurring|frequency)[[:space:]]+[^[:space:]]*[[:space:]]*/ /g')
        task_name=$(echo "$task_name" | tr '\n' ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | sed 's/[[:space:]]\{2,\}/ /g' | head -c 100)
        
        # Update status (write atomically to avoid blank lines)
        {
          echo "[$idx/${#tasks[@]}] Analyzing: $task_name"
          echo "$idx"
        } > "$status_file"
        
        # Capture output from suggest_project_for_task
        # Note: stderr may contain "TIMEOUT" message, stdout contains the result
        # Ensure stderr is not redirected so timer can display
        local suggested_project=""
        local timeout_occurred=false
        
        # Capture stdout only, let stderr (timer) display to terminal
        # We'll detect timeout by checking if result is empty or "TIMEOUT"
        local output=$(suggest_project_for_task "$task_file" 2>/dev/tty)
        
        # Check stderr for timeout message (redirected to stdout in our capture)
        if echo "$output" | grep -q "TIMEOUT"; then
          timeout_occurred=true
          # Update status to show timeout
          {
            echo "[$idx/${#tasks[@]}] ⏱️  Timeout: $task_name (skipped, continuing...)"
            echo "$idx"
          } > "$status_file"
        else
          # Extract the actual suggestion (first non-empty line)
          suggested_project=$(echo "$output" | grep -v '^[[:space:]]*$' | grep -v "TIMEOUT" | head -1 | tr -d '\n\r')
        fi
        
        if [[ "$timeout_occurred" == "true" ]]; then
          suggestions+=("$task_id|$task_name|timeout")
        elif [[ -n "$suggested_project" && "$suggested_project" != "none" ]]; then
          suggestions+=("$task_id|$task_name|$suggested_project")
        else
          suggestions+=("$task_id|$task_name|none")
        fi
      done
      
      # Save results as simple text file (pipe-delimited)
      {
        echo "TOTAL:${#tasks[@]}"
        for suggestion in "${suggestions[@]}"; do
          echo "$suggestion"
        done
      } > "$results_file"
      
      # Mark as complete (write atomically)
      {
        echo "✓ Analysis complete! ${#tasks[@]} tasks analyzed."
        echo "${#tasks[@]}"
      } > "$status_file"
      
      # Send notification
      if command -v gtd-notify &>/dev/null; then
        gtd-notify "Task Organizer" "Analysis complete: ${#tasks[@]} tasks analyzed" "Ready for review" "Glass" 2>/dev/null || true
      fi
    ) > "$log_file" 2>&1 &
    
    local bg_pid=$!
    echo "✓ Background task started (PID: $bg_pid)"
    echo ""
    echo "Results file: $results_file"
    echo "Status file: $status_file"
    echo "Log file: $log_file"
    echo ""
    echo "You can:"
    echo "  • Check progress: tail -f $status_file"
    echo "  • View logs: tail -f $log_file"
    echo "  • You'll be notified when complete"
    echo ""
    echo "Press Enter to continue..."
    read
    return 0
  else
    # Run synchronously (original behavior)
    echo ""
    echo "Analyzing ${#tasks[@]} tasks..."
    echo ""
    
    # Collect suggestions
    local suggestions=()
    local idx=0
    for task_file in "${tasks[@]}"; do
      ((idx++))
      local task_id=$(basename "$task_file" .md)
      local task_name=$(head -20 "$task_file" | grep "^# " | head -1 | sed 's/^# //' || echo "$task_id")
      # Remove any flags that might be embedded in the title
      task_name=$(echo "$task_name" | sed -E 's/[[:space:]]*--(context|priority|energy|project|repository|repo|recurring|frequency)(=[^[:space:]]*)?[[:space:]]*/ /g' | sed 's/[[:space:]]\{2,\}/ /g' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      
      echo "[$idx/${#tasks[@]}] Analyzing: $task_name"
      # Call function without redirecting stderr so timer can display
      # Capture stdout only, let stderr (timer) display to terminal
      local suggested_project=$(suggest_project_for_task "$task_file" 2>/dev/tty)
      
      if [[ -n "$suggested_project" && "$suggested_project" != "none" ]]; then
        suggestions+=("$task_id|$task_name|$suggested_project")
      else
        suggestions+=("$task_id|$task_name|none")
      fi
    done
    
    echo ""
    echo "✓ Analysis complete!"
    echo ""
    echo "Press Enter to review suggestions..."
    read
  fi
  
  # Load suggestions from results file if background mode was used
  local suggestions=()
  if [[ -n "$results_file" && -f "$results_file" ]]; then
    # Load from JSON file
    while IFS= read -r line; do
      if [[ "$line" =~ \"task_id\":\ \"([^\"]+)\" ]]; then
        local task_id="${BASH_REMATCH[1]}"
        # This is simplified - in practice you'd parse the full JSON
        # For now, we'll use a simpler approach
      fi
    done < "$results_file"
    
    # Re-analyze to get suggestions array (or parse JSON properly)
    # For simplicity, let's just re-run the analysis if we need to review
    echo ""
    echo "Loading results from background analysis..."
    # Parse JSON and rebuild suggestions array
    local task_count=0
    while IFS= read -r task_file; do
      [[ ! -f "$task_file" ]] && continue
      local task_id=$(basename "$task_file" .md)
      local task_name=$(head -20 "$task_file" | grep "^# " | head -1 | sed 's/^# //' || echo "$task_id")
      
      # Extract suggestion from JSON (simplified - would use jq or python in production)
      local suggested_project=$(grep -A 3 "\"task_id\": \"$task_id\"" "$results_file" 2>/dev/null | grep "\"suggested_project\"" | sed 's/.*"suggested_project": "\([^"]*\)".*/\1/')
      if [[ -z "$suggested_project" ]]; then
        suggested_project="none"
      fi
      
      suggestions+=("$task_id|$task_name|$suggested_project")
    done < <(get_tasks_without_projects)
  fi
  
  # Review suggestions using shared function
  review_suggestions_from_array suggestions
}

# Main
main() {
  case "${1:-}" in
    --help|-h)
      echo "Usage: gtd-task-organize"
      echo ""
      echo "Interactive tool to organize your task backlog:"
      echo "  - Review tasks without projects"
      echo "  - Clean up completed tasks"
      echo "  - Bulk organize with AI suggestions"
      echo ""
      exit 0
      ;;
    "")
      # No arguments - launch interactive menu
      organize_menu
      ;;
    *)
      echo "Unknown option: $1"
      echo "Run 'gtd-task-organize --help' for usage"
      exit 1
      ;;
  esac
}

main "$@"

