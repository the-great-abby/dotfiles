#!/bin/bash
# GTD Second Brain Sync - Sync between GTD and Second Brain systems

# Source common environment (PATH setup)
COMMON_ENV="$HOME/code/dotfiles/zsh/common_env.sh"
if [[ ! -f "$COMMON_ENV" && -f "$HOME/code/personal/dotfiles/zsh/common_env.sh" ]]; then
  COMMON_ENV="$HOME/code/personal/dotfiles/zsh/common_env.sh"
fi
if [[ -f "$COMMON_ENV" ]]; then
  source "$COMMON_ENV"
fi


# Load GTD config
GTD_CONFIG_FILE="$HOME/.gtd_config"
if [[ -f "$HOME/code/dotfiles/zsh/.gtd_config" ]]; then
  GTD_CONFIG_FILE="$HOME/code/dotfiles/zsh/.gtd_config"
elif [[ -f "$HOME/code/personal/dotfiles/zsh/.gtd_config" ]]; then
  GTD_CONFIG_FILE="$HOME/code/personal/dotfiles/zsh/.gtd_config"
fi

# Source config if it exists
if [[ -f "$GTD_CONFIG_FILE" ]]; then
  source "$GTD_CONFIG_FILE"
fi

# Load daily log config
DAILY_LOG_CONFIG="$HOME/.daily_log_config"
if [[ -f "$HOME/code/dotfiles/zsh/.daily_log_config" ]]; then
  DAILY_LOG_CONFIG="$HOME/code/dotfiles/zsh/.daily_log_config"
elif [[ -f "$HOME/code/personal/dotfiles/zsh/.daily_log_config" ]]; then
  DAILY_LOG_CONFIG="$HOME/code/personal/dotfiles/zsh/.daily_log_config"
fi

if [[ -f "$DAILY_LOG_CONFIG" ]]; then
  source "$DAILY_LOG_CONFIG"
fi

# Source common GTD helpers (DRY - reuse existing helpers)
GTD_COMMON="$HOME/code/dotfiles/bin/gtd-common.sh"
if [[ ! -f "$GTD_COMMON" && -f "$HOME/code/personal/dotfiles/bin/gtd-common.sh" ]]; then
  GTD_COMMON="$HOME/code/personal/dotfiles/bin/gtd-common.sh"
fi
if [[ -f "$GTD_COMMON" ]]; then
  source "$GTD_COMMON"
else
  echo "Warning: gtd-common.sh not found. Some features may not work." >&2
fi

# Default values
# GTD_BASE_DIR is already set by init_gtd_paths in gtd-common.sh (DRY - reuse existing helper)
SECOND_BRAIN="${SECOND_BRAIN:-$HOME/Documents/obsidian/Second Brain}"
GTD_PROJECTS_DIR="${GTD_PROJECTS_DIR:-1-projects}"
GTD_AREAS_DIR="${GTD_AREAS_DIR:-2-areas}"
DAILY_LOG_DIR="${DAILY_LOG_DIR:-$HOME/Documents/daily_logs}"

# Sync GTD projects to Second Brain Projects
sync_projects() {
  echo "🔄 Syncing GTD Projects to Second Brain..."
  
  local gtd_projects="$GTD_BASE_DIR/$GTD_PROJECTS_DIR"
  local brain_projects="$SECOND_BRAIN/Projects"
  
  mkdir -p "$brain_projects"
  
  local total=0
  local created=0
  local skipped=0
  local linked=0
  
  while IFS= read -r project_file; do
    ((total++))
    local project_name=$(basename "$project_file" .md)
    local brain_note="$brain_projects/${project_name}.md"
    
    echo "  📄 Processing: $project_name"
    
    # Check if already linked
    if grep -q "## Second Brain" "$project_file" 2>/dev/null; then
      echo "    ⏭️  Already linked, skipping"
      ((skipped++))
      continue
    fi
    
    # Create or update brain note
    if [[ ! -f "$brain_note" ]]; then
      cat > "$brain_note" <<EOF
# $project_name

Created: $(date +"%Y-%m-%d %H:%M")

## GTD Project
- [[GTD Project: $project_name]] → $project_file

## Notes

## Links

## Tags
#project #gtd

## Summary

EOF
      echo "    ✓ Created brain note: ${brain_note#$SECOND_BRAIN/}"
      ((created++))
    else
      echo "    ℹ️  Brain note already exists: ${brain_note#$SECOND_BRAIN/}"
    fi
    
    # Add link in GTD project
    if [[ "$GTD_BIDIRECTIONAL_LINKS" == "true" ]]; then
      if ! grep -q "## Second Brain" "$project_file" 2>/dev/null; then
        echo "" >> "$project_file"
        echo "## Second Brain" >> "$project_file"
        echo "- [[$project_name]] → $brain_note" >> "$project_file"
        echo "    ✓ Linked GTD project to brain note"
        ((linked++))
      fi
    fi
  done < <(find "$gtd_projects" -type f -name "*.md" 2>/dev/null)
  
  echo "✓ Project sync complete (Total: $total, Created: $created, Skipped: $skipped, Linked: $linked)"
}

# Sync GTD areas to Second Brain Areas
sync_areas() {
  echo "🔄 Syncing GTD Areas to Second Brain..."
  
  local gtd_areas="$GTD_BASE_DIR/$GTD_AREAS_DIR"
  local brain_areas="$SECOND_BRAIN/Areas"
  
  mkdir -p "$brain_areas"
  
  local total=0
  local created=0
  local skipped=0
  local linked=0
  
  while IFS= read -r area_file; do
    ((total++))
    local area_name=$(basename "$area_file" .md)
    local brain_note="$brain_areas/${area_name}.md"
    
    echo "  📄 Processing: $area_name"
    
    # Check if already linked
    if grep -q "## Second Brain" "$area_file" 2>/dev/null; then
      echo "    ⏭️  Already linked, skipping"
      ((skipped++))
      continue
    fi
    
    # Create or update brain note
    if [[ ! -f "$brain_note" ]]; then
      cat > "$brain_note" <<EOF
# $area_name

Created: $(date +"%Y-%m-%d %H:%M")

## GTD Area
- [[GTD Area: $area_name]] → $area_file

## Notes

## Links

## Tags
#area #gtd

## Summary

EOF
      echo "    ✓ Created brain note: ${brain_note#$SECOND_BRAIN/}"
      ((created++))
    else
      echo "    ℹ️  Brain note already exists: ${brain_note#$SECOND_BRAIN/}"
    fi
    
    # Add link in GTD area
    if [[ "$GTD_BIDIRECTIONAL_LINKS" == "true" ]]; then
      if ! grep -q "## Second Brain" "$area_file" 2>/dev/null; then
        echo "" >> "$area_file"
        echo "## Second Brain" >> "$area_file"
        echo "- [[$area_name]] → $brain_note" >> "$area_file"
        echo "    ✓ Linked GTD area to brain note"
        ((linked++))
      fi
    fi
  done < <(find "$gtd_areas" -type f -name "*.md" 2>/dev/null)
  
  echo "✓ Area sync complete (Total: $total, Created: $created, Skipped: $skipped, Linked: $linked)"
}

# Auto-link reference items to Resources
sync_references() {
  echo "🔄 Syncing GTD References to Second Brain Resources..."
  
  local gtd_refs="$GTD_BASE_DIR/3-reference"
  local brain_resources="$SECOND_BRAIN/Resources"
  
  mkdir -p "$brain_resources"
  
  local total=0
  local copied=0
  local skipped=0
  local linked=0
  
  while IFS= read -r ref_file; do
    ((total++))
    local ref_name=$(basename "$ref_file" .md)
    local brain_note="$brain_resources/${ref_name}.md"
    
    echo "  📄 Processing: $ref_name"
    
    # Only sync if not already linked
    if grep -q "## Second Brain" "$ref_file" 2>/dev/null; then
      echo "    ⏭️  Already linked, skipping"
      ((skipped++))
      continue
    fi
    
    # Create brain note if it doesn't exist
    if [[ ! -f "$brain_note" ]]; then
      # Copy content or create link
      if [[ -f "$ref_file" ]]; then
        cp "$ref_file" "$brain_note"
        echo "    ✓ Copied reference to Resources: ${brain_note#$SECOND_BRAIN/}"
        ((copied++))
      fi
    else
      echo "    ℹ️  Resource note already exists: ${brain_note#$SECOND_BRAIN/}"
    fi
    
    # Add link in GTD reference
    if [[ "$GTD_BIDIRECTIONAL_LINKS" == "true" ]]; then
      if ! grep -q "## Second Brain" "$ref_file" 2>/dev/null; then
        echo "" >> "$ref_file"
        echo "## Second Brain" >> "$ref_file"
        echo "- [[$ref_name]] → $brain_note" >> "$ref_file"
        echo "    ✓ Linked GTD reference to brain note"
        ((linked++))
      fi
    fi
  done < <(find "$gtd_refs" -type f -name "*.md" 2>/dev/null)
  
  echo "✓ Reference sync complete (Total: $total, Copied: $copied, Skipped: $skipped, Linked: $linked)"
}

# Initialize git repo in GTD directory if it doesn't exist
init_gtd_git_repo() {
  if [[ ! -d "$GTD_BASE_DIR" ]]; then
    mkdir -p "$GTD_BASE_DIR"
  fi
  
  # Check if git repo exists
  if [[ ! -d "$GTD_BASE_DIR/.git" ]]; then
    echo "📦 Initializing git repository in GTD directory..."
    cd "$GTD_BASE_DIR" || return 1
    
    # Initialize git repo
    git init --quiet || return 1
    
    # Create .gitignore if it doesn't exist
    if [[ ! -f "$GTD_BASE_DIR/.gitignore" ]]; then
      cat > "$GTD_BASE_DIR/.gitignore" <<EOF
# GTD Git Ignore
*.backup.*
*.banter.*
*.tmp
*.swp
*~
.DS_Store
.gtd/
*.txt
EOF
      git add .gitignore
      git commit -m "Initial commit: Add .gitignore" --quiet 2>/dev/null || true
    fi
    
    echo "  ✓ Git repository initialized"
  fi
}

# General merge function for all file types
# Detects file type and uses appropriate merge strategy
merge_files() {
  local source_file="$1"
  local dest_file="$2"
  local output_file="$3"
  
  # Check if files exist
  if [[ ! -f "$source_file" && ! -f "$dest_file" ]]; then
    return 1
  fi
  
  # If one file doesn't exist, use the other
  if [[ ! -f "$source_file" ]]; then
    cp "$dest_file" "$output_file" 2>/dev/null
    return $?
  fi
  
  if [[ ! -f "$dest_file" ]]; then
    cp "$source_file" "$output_file" 2>/dev/null
    return $?
  fi
  
  # Determine file type
  local filename=$(basename "$source_file")
  local extension="${filename##*.}"
  local is_daily_log=false
  local is_markdown=false
  
  # Check if it's a daily log (by pattern or extension)
  if [[ "$filename" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\.(md|txt)$ ]]; then
    is_daily_log=true
  fi
  
  # Check if it's markdown
  if [[ "$extension" == "md" ]] || [[ "$extension" == "markdown" ]]; then
    is_markdown=true
  fi
  
  # Use appropriate merge strategy
  if [[ "$is_daily_log" == "true" ]]; then
    merge_daily_log "$source_file" "$dest_file" "$output_file"
    return $?
  elif [[ "$is_markdown" == "true" ]]; then
    merge_markdown "$source_file" "$dest_file" "$output_file"
    return $?
  else
    # For other files, try to merge intelligently
    merge_text_file "$source_file" "$dest_file" "$output_file"
    return $?
  fi
}

# Merge daily log files by combining unique entries
# Preserves all entries from both files, deduplicates by timestamp
merge_daily_log() {
  local source_file="$1"
  local dest_file="$2"
  local output_file="$3"
  
  # Create temp files for processing
  local temp_dir=$(mktemp -d)
  local source_entries="$temp_dir/source_entries"
  local dest_entries="$temp_dir/dest_entries"
  local merged_entries="$temp_dir/merged_entries"
  local all_entries="$temp_dir/all_entries"
  
  # Extract header (first line if it's not a timestamp entry)
  local source_header=""
  local dest_header=""
  
  if [[ -f "$source_file" ]]; then
    local first_line=$(head -n 1 "$source_file" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    if [[ -n "$first_line" ]] && ! [[ "$first_line" =~ ^[0-9]{2}:[0-9]{2} ]]; then
      source_header="$first_line"
    fi
  fi
  
  if [[ -f "$dest_file" ]]; then
    local first_line=$(head -n 1 "$dest_file" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    if [[ -n "$first_line" ]] && ! [[ "$first_line" =~ ^[0-9]{2}:[0-9]{2} ]]; then
      dest_header="$first_line"
    fi
  fi
  
  # Use the header from the source file, or dest if source doesn't have one
  local header="${source_header:-${dest_header}}"
  
  # Extract time-stamped entries from source file (format: HH:MM - entry)
  # Use process substitution to avoid subshell issues
  if [[ -f "$source_file" ]]; then
    grep -E '^[0-9]{2}:[0-9]{2}\s+-' "$source_file" 2>/dev/null > "$source_entries" || touch "$source_entries"
  else
    touch "$source_entries"
  fi
  
  # Extract time-stamped entries from dest file
  if [[ -f "$dest_file" ]]; then
    grep -E '^[0-9]{2}:[0-9]{2}\s+-' "$dest_file" 2>/dev/null > "$dest_entries" || touch "$dest_entries"
  else
    touch "$dest_entries"
  fi
  
  # Merge entries: combine both, prefer newer file for conflicts
  local source_mtime=0
  local dest_mtime=0
  
  if [[ -f "$source_file" ]]; then
    source_mtime=$(stat -f %m "$source_file" 2>/dev/null || stat -c %Y "$source_file" 2>/dev/null || echo "0")
  fi
  
  if [[ -f "$dest_file" ]]; then
    dest_mtime=$(stat -f %m "$dest_file" 2>/dev/null || stat -c %Y "$dest_file" 2>/dev/null || echo "0")
  fi
  
  # Build a map of timestamps to entries, preferring newer file for conflicts
  > "$all_entries"
  
  # Process source entries
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -n "$line" ]]; then
      local timestamp=$(echo "$line" | sed -E 's/^([0-9]{2}:[0-9]{2}).*/\1/')
      echo "${timestamp}|${line}" >> "$all_entries"
    fi
  done < "$source_entries"
  
  # Process dest entries (overwrite if timestamp exists and dest is newer)
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -n "$line" ]]; then
      local timestamp=$(echo "$line" | sed -E 's/^([0-9]{2}:[0-9]{2}).*/\1/')
      # Check if this timestamp already exists
      if grep -q "^${timestamp}|" "$all_entries" 2>/dev/null; then
        # Timestamp exists - replace if dest is newer
        if [[ "$dest_mtime" -gt "$source_mtime" ]]; then
          # Remove old entry and add new one
          grep -v "^${timestamp}|" "$all_entries" > "${all_entries}.tmp" && mv "${all_entries}.tmp" "$all_entries"
          echo "${timestamp}|${line}" >> "$all_entries"
        fi
      else
        # New timestamp, add it
        echo "${timestamp}|${line}" >> "$all_entries"
      fi
    fi
  done < "$dest_entries"
  
  # Build merged content with proper time sorting
  {
    # Add header if present
    if [[ -n "$header" ]]; then
      echo "$header"
      echo ""
    fi
    
    # Sort by timestamp (convert HH:MM to minutes since midnight for proper sorting)
    # Format: convert "HH:MM" to "HHMM" for numeric sort, then back
    while IFS='|' read -r timestamp entry || [[ -n "$timestamp" ]]; do
      if [[ -n "$timestamp" && -n "$entry" ]]; then
        # Convert HH:MM to sortable format (pad with zeros for numeric sort)
        # Use 10# prefix to force decimal interpretation (prevents octal issues with 08, 09)
        local hours=$(echo "$timestamp" | cut -d: -f1)
        local minutes=$(echo "$timestamp" | cut -d: -f2)
        # Remove leading zeros for arithmetic, then pad back
        local hours_num=$((10#$hours))
        local minutes_num=$((10#$minutes))
        local sort_key=$(printf "%02d%02d" "$hours_num" "$minutes_num")
        echo "${sort_key}|${timestamp}|${entry}"
      fi
    done < "$all_entries" | sort -t'|' -k1,1n | cut -d'|' -f3-
  } > "$merged_entries"
  
  # Copy merged content to output file
  if [[ -f "$merged_entries" && -s "$merged_entries" ]]; then
    cp "$merged_entries" "$output_file" 2>/dev/null
    local result=$?
  else
    # If merge produced empty file, try to preserve at least one file
    if [[ -f "$source_file" && -s "$source_file" ]]; then
      cp "$source_file" "$output_file" 2>/dev/null
      local result=$?
    elif [[ -f "$dest_file" && -s "$dest_file" ]]; then
      cp "$dest_file" "$output_file" 2>/dev/null
      local result=$?
    else
      local result=1
    fi
  fi
  
  # Cleanup
  rm -rf "$temp_dir" 2>/dev/null
  
  return $result
}

# Merge markdown files by sections
# Preserves unique sections from both files, merges conflicting sections
merge_markdown() {
  local source_file="$1"
  local dest_file="$2"
  local output_file="$3"
  
  # Use the simpler section-based merge
  merge_markdown_sections "$source_file" "$dest_file" "$output_file"
  return $?
}

# Merge markdown files by sections (headers)
# Extracts sections and merges them intelligently
merge_markdown_sections() {
  local source_file="$1"
  local dest_file="$2"
  local output_file="$3"
  
  local temp_dir=$(mktemp -d)
  local source_sections="$temp_dir/source_sections"
  local dest_sections="$temp_dir/dest_sections"
  local merged="$temp_dir/merged"
  
  # Extract sections from both files (sections are defined by headers: #, ##, ###, etc.)
  # This is a simplified approach - extract content between headers
  > "$merged"
  
  # Get modification times
  local source_mtime=0
  local dest_mtime=0
  
  if [[ -f "$source_file" ]]; then
    source_mtime=$(stat -f %m "$source_file" 2>/dev/null || stat -c %Y "$source_file" 2>/dev/null || echo "0")
  fi
  
  if [[ -f "$dest_file" ]]; then
    dest_mtime=$(stat -f %m "$dest_file" 2>/dev/null || stat -c %Y "$dest_file" 2>/dev/null || echo "0")
  fi
  
  # Simple strategy: combine both files, with newer file taking precedence for overlapping content
  # Start with older file as base, then overlay newer file
  if [[ "$source_mtime" -gt "$dest_mtime" ]]; then
    # Source is newer - use dest as base, overlay source
    cat "$dest_file" > "$merged" 2>/dev/null
    echo "" >> "$merged"
    echo "<!-- Merged from: $(basename "$source_file") (newer) -->" >> "$merged"
    echo "" >> "$merged"
    # Append unique content from source (lines not in dest)
    comm -13 <(sort "$dest_file" 2>/dev/null) <(sort "$source_file" 2>/dev/null) >> "$merged" 2>/dev/null || cat "$source_file" >> "$merged" 2>/dev/null
  else
    # Dest is newer - use source as base, overlay dest
    cat "$source_file" > "$merged" 2>/dev/null
    echo "" >> "$merged"
    echo "<!-- Merged from: $(basename "$dest_file") (newer) -->" >> "$merged"
    echo "" >> "$merged"
    # Append unique content from dest (lines not in source)
    comm -13 <(sort "$source_file" 2>/dev/null) <(sort "$dest_file" 2>/dev/null) >> "$merged" 2>/dev/null || cat "$dest_file" >> "$merged" 2>/dev/null
  fi
  
  # If merge is too large or failed, prefer newer file
  if [[ ! -s "$merged" ]] || [[ $(wc -l < "$merged" 2>/dev/null || echo "0") -gt 10000 ]]; then
    if [[ "$source_mtime" -gt "$dest_mtime" ]]; then
      cp "$source_file" "$output_file" 2>/dev/null
    else
      cp "$dest_file" "$output_file" 2>/dev/null
    fi
  else
    cp "$merged" "$output_file" 2>/dev/null
  fi
  
  local result=$?
  rm -rf "$temp_dir" 2>/dev/null
  return $result
}

# Merge general text files
# Tries to preserve content from both files
merge_text_file() {
  local source_file="$1"
  local dest_file="$2"
  local output_file="$3"
  
  local temp_dir=$(mktemp -d)
  local merged="$temp_dir/merged"
  
  # Get modification times
  local source_mtime=0
  local dest_mtime=0
  
  if [[ -f "$source_file" ]]; then
    source_mtime=$(stat -f %m "$source_file" 2>/dev/null || stat -c %Y "$source_file" 2>/dev/null || echo "0")
  fi
  
  if [[ -f "$dest_file" ]]; then
    dest_mtime=$(stat -f %m "$dest_file" 2>/dev/null || stat -c %Y "$dest_file" 2>/dev/null || echo "0")
  fi
  
  # Try to use diff3 if available
  if command -v diff3 &>/dev/null; then
    local base_file="$temp_dir/base"
    if [[ "$source_mtime" -lt "$dest_mtime" ]]; then
      cp "$source_file" "$base_file" 2>/dev/null || echo "" > "$base_file"
    else
      cp "$dest_file" "$base_file" 2>/dev/null || echo "" > "$base_file"
    fi
    
    if diff3 -m "$source_file" "$base_file" "$dest_file" > "$merged" 2>/dev/null; then
      # Prefer newer file for conflicts
      local prefer_newer=""
      if [[ "$source_mtime" -gt "$dest_mtime" ]]; then
        prefer_newer="source"
      else
        prefer_newer="dest"
      fi
      
      # Simple conflict resolution: remove markers and use newer
      if [[ "$prefer_newer" == "source" ]]; then
        # Remove conflict markers and keep source content
        sed -E '/^<<<<<<< /,/^>>>>>>> /d' "$merged" > "${merged}.tmp" 2>/dev/null || cp "$merged" "${merged}.tmp"
        # Actually, let's keep the merged result but prefer source in conflicts
        awk -v prefer="$prefer_newer" '
          /^<<<<<<< / { in_conflict=1; conflict_source=""; conflict_dest=""; next }
          /^=======/ { in_dest=1; next }
          /^>>>>>>> / { 
            if (prefer=="source") print conflict_source; 
            else print conflict_dest; 
            in_conflict=0; in_dest=0; next 
          }
          in_conflict && !in_dest { conflict_source=conflict_source (conflict_source?"\n":"") $0; next }
          in_conflict && in_dest { conflict_dest=conflict_dest (conflict_dest?"\n":"") $0; next }
          !in_conflict { print }
        ' "$merged" > "${merged}.tmp" 2>/dev/null || cp "$merged" "${merged}.tmp"
        mv "${merged}.tmp" "$merged"
      fi
      
      cp "$merged" "$output_file" 2>/dev/null
      local result=$?
    else
      # diff3 failed, prefer newer file
      if [[ "$source_mtime" -gt "$dest_mtime" ]]; then
        cp "$source_file" "$output_file" 2>/dev/null
      else
        cp "$dest_file" "$output_file" 2>/dev/null
      fi
      local result=$?
    fi
  else
    # No diff3 - combine files with newer taking precedence
    if [[ "$source_mtime" -gt "$dest_mtime" ]]; then
      # Source is newer - use it as base, append unique lines from dest
      cat "$source_file" > "$merged" 2>/dev/null
      echo "" >> "$merged"
      echo "# Merged content from: $(basename "$dest_file")" >> "$merged"
      echo "" >> "$merged"
      comm -13 <(sort "$source_file" 2>/dev/null) <(sort "$dest_file" 2>/dev/null) >> "$merged" 2>/dev/null || {
        # comm failed, just append dest
        echo "---" >> "$merged"
        cat "$dest_file" >> "$merged" 2>/dev/null
      }
    else
      # Dest is newer - use it as base, append unique lines from source
      cat "$dest_file" > "$merged" 2>/dev/null
      echo "" >> "$merged"
      echo "# Merged content from: $(basename "$source_file")" >> "$merged"
      echo "" >> "$merged"
      comm -13 <(sort "$dest_file" 2>/dev/null) <(sort "$source_file" 2>/dev/null) >> "$merged" 2>/dev/null || {
        # comm failed, just append source
        echo "---" >> "$merged"
        cat "$source_file" >> "$merged" 2>/dev/null
      }
    fi
    
    cp "$merged" "$output_file" 2>/dev/null
    local result=$?
  fi
  
  rm -rf "$temp_dir" 2>/dev/null
  return $result
}

# Git-based sync: commit changes and sync to Second Brain
git_sync_to_second_brain() {
  local source_dir="$1"
  local dest_dir="$2"
  local sync_type="${3:-files}"  # files, daily-logs, etc.
  
  if [[ ! -d "$source_dir" ]]; then
    echo "  ⚠️  Source directory not found: $source_dir"
    return 1
  fi
  
  # Initialize git repo if needed
  init_gtd_git_repo
  
  # Check if we're in a git repo (might be in daily log dir, not GTD base)
  local git_root=""
  if git rev-parse --git-dir &>/dev/null; then
    git_root=$(git rev-parse --show-toplevel 2>/dev/null)
  fi
  
  # If not in a git repo, try GTD_BASE_DIR
  if [[ -z "$git_root" && -d "$GTD_BASE_DIR/.git" ]]; then
  cd "$GTD_BASE_DIR" || return 1
    git_root="$GTD_BASE_DIR"
  elif [[ -z "$git_root" ]]; then
    # Not a git repo - that's okay, we'll still sync files
    echo "  ℹ️  Not in a git repository (this is okay, files will still sync)"
  else
    cd "$git_root" || return 1
  fi
  
  # Only try git operations if we're in a git repo
  if [[ -n "$git_root" && -d "$git_root/.git" ]]; then
  # Stage all changes
  git add -A 2>/dev/null || true
  
  # Check if there are changes to commit
  if git diff --staged --quiet 2>/dev/null && git diff --quiet 2>/dev/null; then
    # No changes, but still sync files
      echo "  ℹ️  No git changes to commit"
    else
    # Show what's being committed
    local changed_files=$(git diff --staged --name-only 2>/dev/null | wc -l | tr -d ' ')
    if [[ -n "$changed_files" && "$changed_files" -gt 0 ]]; then
      echo "  📝 Staging ${changed_files} file(s) for commit"
      git diff --staged --name-only 2>/dev/null | head -5 | while read -r file; do
        echo "    • ${file#$GTD_BASE_DIR/}"
      done
      if [[ "$changed_files" -gt 5 ]]; then
        echo "    ... and $((changed_files - 5)) more"
      fi
    fi
    
    # Commit with timestamp
    local timestamp=$(date +"%Y-%m-%d %H:%M:%S")
    local commit_msg="Sync ${sync_type} to Second Brain - ${timestamp}"
    
    git commit -m "$commit_msg" --quiet 2>/dev/null && {
      echo "  ✓ Committed changes: ${commit_msg}"
    } || {
        echo "  ⚠️  Commit failed or no changes to commit"
    }
    fi
  fi
  
  # Create destination directory
  mkdir -p "$dest_dir"
  
  # Copy files to Second Brain (excluding ignored files)
  # Include both .md and .txt files for daily logs
  local files_copied=0
  local files_skipped=0
  local total_files=0
  
  echo "  📂 Source directory: $source_dir"
  echo "  📂 Destination directory: $dest_dir"
  echo ""
  
  while IFS= read -r file; do
    if [[ -f "$file" ]]; then
      ((total_files++))
      local rel_path="${file#$source_dir/}"
      local dest_file="$dest_dir/$rel_path"
      local dest_dir_path=$(dirname "$dest_file")
      
      mkdir -p "$dest_dir_path"
      
      # Show what files we're comparing (verbose mode)
      echo "  🔍 File: ${rel_path}"
      echo "    Source: $file"
      echo "    Dest:   $dest_file"
      
      # Check if destination exists and compare
      if [[ ! -f "$dest_file" ]]; then
        # File doesn't exist in destination - always copy
        if cp "$file" "$dest_file" 2>/dev/null; then
          ((files_copied++))
          echo "    ✓ Copied (new): ${rel_path}"
        else
          echo "    ⚠️  Failed to copy: ${rel_path}"
        fi
      elif [[ "$file" -nt "$dest_file" ]] || ! diff -q "$file" "$dest_file" &>/dev/null; then
        # Files differ - merge instead of overwriting
        local temp_merged=$(mktemp)
        if merge_files "$file" "$dest_file" "$temp_merged"; then
          if cp "$temp_merged" "$dest_file" 2>/dev/null; then
            ((files_copied++))
            echo "    ✓ Merged (preserved existing content): ${rel_path}"
          else
            echo "    ⚠️  Failed to write merged file: ${rel_path}"
          fi
        else
          # Merge failed, fall back to copy if source is newer
          if [[ "$file" -nt "$dest_file" ]]; then
            if cp "$file" "$dest_file" 2>/dev/null; then
              ((files_copied++))
              echo "    ✓ Copied (merge failed, source newer): ${rel_path}"
            else
              echo "    ⚠️  Failed to copy: ${rel_path}"
            fi
          else
            echo "    ⏭️  Skipped (merge failed, dest newer): ${rel_path}"
            ((files_skipped++))
          fi
        fi
        rm -f "$temp_merged" 2>/dev/null
      elif [[ "$file" -nt "$dest_file" ]]; then
        # Source is newer - copy
        if cp "$file" "$dest_file" 2>/dev/null; then
          ((files_copied++))
          echo "    ✓ Copied (updated): ${rel_path}"
        else
          echo "    ⚠️  Failed to copy: ${rel_path}"
        fi
      else
        # Files exist and source is not newer - check if they're actually different
        # Use checksum comparison to be more accurate than timestamp
        local source_checksum=""
        local dest_checksum=""
        local checksum_tool=""
        
        # Determine which checksum tool is available
        if command -v md5sum &>/dev/null; then
          checksum_tool="md5sum"
          source_checksum=$(md5sum "$file" 2>/dev/null | cut -d' ' -f1)
          dest_checksum=$(md5sum "$dest_file" 2>/dev/null | cut -d' ' -f1)
        elif command -v md5 &>/dev/null; then
          checksum_tool="md5"
          source_checksum=$(md5 -q "$file" 2>/dev/null)
          dest_checksum=$(md5 -q "$dest_file" 2>/dev/null)
        elif command -v shasum &>/dev/null; then
          checksum_tool="shasum"
          source_checksum=$(shasum -a 256 "$file" 2>/dev/null | cut -d' ' -f1)
          dest_checksum=$(shasum -a 256 "$dest_file" 2>/dev/null | cut -d' ' -f1)
        fi
        
        # If checksum comparison failed or tools aren't available, use file size and diff as fallback
        if [[ -z "$source_checksum" || -z "$dest_checksum" ]]; then
          # Fallback: compare file sizes and do a quick diff
          local source_size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo "0")
          local dest_size=$(stat -f%z "$dest_file" 2>/dev/null || stat -c%s "$dest_file" 2>/dev/null || echo "0")
          
          if [[ "$source_size" != "$dest_size" ]]; then
            # Different sizes - definitely different, merge them
            local temp_merged=$(mktemp)
            if merge_files "$file" "$dest_file" "$temp_merged"; then
              if cp "$temp_merged" "$dest_file" 2>/dev/null; then
                ((files_copied++))
                echo "    ✓ Merged (size differs: ${source_size} vs ${dest_size}): ${rel_path}"
              else
                echo "    ⚠️  Failed to write merged file: ${rel_path}"
              fi
            else
              if [[ "$file" -nt "$dest_file" ]]; then
                if cp "$file" "$dest_file" 2>/dev/null; then
                  ((files_copied++))
                  echo "    ✓ Copied (merge failed, size differs): ${rel_path}"
                else
                  echo "    ⚠️  Failed to copy: ${rel_path}"
                fi
              else
                ((files_skipped++))
                echo "    ⏭️  Skipped (merge failed, dest newer): ${rel_path}"
              fi
            fi
            rm -f "$temp_merged" 2>/dev/null
          elif command -v diff &>/dev/null; then
            # Same size - do a quick diff check
            if ! diff -q "$file" "$dest_file" &>/dev/null; then
              # Files differ - merge them
              local temp_merged=$(mktemp)
              if merge_files "$file" "$dest_file" "$temp_merged"; then
                if cp "$temp_merged" "$dest_file" 2>/dev/null; then
                  ((files_copied++))
                  echo "    ✓ Merged (content differs per diff): ${rel_path}"
                else
                  echo "    ⚠️  Failed to write merged file: ${rel_path}"
                fi
              else
                if [[ "$file" -nt "$dest_file" ]]; then
                  if cp "$file" "$dest_file" 2>/dev/null; then
                    ((files_copied++))
                    echo "    ✓ Copied (merge failed, content differs): ${rel_path}"
                  else
                    echo "    ⚠️  Failed to copy: ${rel_path}"
                  fi
                else
                  ((files_skipped++))
                  echo "    ⏭️  Skipped (merge failed, dest newer): ${rel_path}"
                fi
              fi
              rm -f "$temp_merged" 2>/dev/null
            else
              # Files are the same
              ((files_skipped++))
              echo "    ⏭️  Skipped (identical): ${rel_path}"
            fi
          else
            # No diff tool either - be conservative and copy if sizes match but we can't verify
            # Actually, if we can't verify, let's copy to be safe
            if cp "$file" "$dest_file" 2>/dev/null; then
              ((files_copied++))
              echo "    ✓ Copied (cannot verify, syncing to be safe): ${rel_path}"
            else
              echo "    ⚠️  Failed to copy: ${rel_path}"
            fi
          fi
        elif [[ "$source_checksum" != "$dest_checksum" ]]; then
          # Checksums differ - files are different, merge them
          local temp_merged=$(mktemp)
          if merge_files "$file" "$dest_file" "$temp_merged"; then
            if cp "$temp_merged" "$dest_file" 2>/dev/null; then
              ((files_copied++))
              echo "    ✓ Merged (content differs per ${checksum_tool}): ${rel_path}"
            else
              echo "    ⚠️  Failed to write merged file: ${rel_path}"
            fi
          else
            # Merge failed, copy source if it's newer
            if [[ "$file" -nt "$dest_file" ]]; then
              if cp "$file" "$dest_file" 2>/dev/null; then
                ((files_copied++))
                echo "    ✓ Copied (merge failed, content differs): ${rel_path}"
              else
                echo "    ⚠️  Failed to copy: ${rel_path}"
              fi
            else
              ((files_skipped++))
              echo "    ⏭️  Skipped (merge failed, dest newer): ${rel_path}"
            fi
          fi
          rm -f "$temp_merged" 2>/dev/null
        else
          # Checksums match - but verify with diff to catch silent checksum failures
          if command -v diff &>/dev/null; then
            if diff -q "$file" "$dest_file" &>/dev/null; then
              # Files are truly identical
              ((files_skipped++))
              echo "    ⏭️  Skipped (identical per ${checksum_tool} and diff): ${rel_path}"
            else
              # Checksum said identical but diff shows difference - checksum may have failed
              # Copy to be safe
              if cp "$file" "$dest_file" 2>/dev/null; then
                ((files_copied++))
                echo "    ✓ Copied (checksum matched but diff shows difference): ${rel_path}"
              else
                echo "    ⚠️  Failed to copy: ${rel_path}"
              fi
            fi
          else
            # No diff tool - trust checksum (but this is less reliable)
            ((files_skipped++))
            echo "    ⏭️  Skipped (identical per ${checksum_tool}): ${rel_path}"
          fi
        fi
      fi
    fi
  done < <(find "$source_dir" -type f \( -name "*.md" -o -name "*.txt" \) ! -name "*.banter.*" ! -name "*.backup.*" ! -name ".*" ! -name ".txt" ! -name ".md" 2>/dev/null)
  
  echo "  📊 Sync summary: ${files_copied} copied, ${files_skipped} skipped (identical), ${total_files} total"
}

# Git-based sync: pull from Second Brain
git_sync_from_second_brain() {
  local source_dir="$1"
  local dest_dir="$2"
  
  if [[ ! -d "$source_dir" ]]; then
    echo "  ⚠️  Source directory not found: $source_dir"
    return 1
  fi
  
  mkdir -p "$dest_dir"
  
  # Copy files from Second Brain to local (only if newer)
  # Include both .md and .txt files for daily logs
  local files_copied=0
  local files_skipped=0
  local total_files=0
  
  echo "  📂 Source directory (Second Brain): $source_dir"
  echo "  📂 Destination directory (local): $dest_dir"
  echo ""
  
  while IFS= read -r file; do
    if [[ -f "$file" ]]; then
      ((total_files++))
      local rel_path="${file#$source_dir/}"
      local dest_file="$dest_dir/$rel_path"
      local dest_dir_path=$(dirname "$dest_file")
      
      mkdir -p "$dest_dir_path"
      
      # Show what files we're comparing (verbose mode)
      echo "  🔍 File: ${rel_path}"
      echo "    Source: $file"
      echo "    Dest:   $dest_file"
      
      # Show what files we're comparing (verbose mode)
      echo "  🔍 Comparing files:"
      echo "    Source: $file"
      echo "    Dest:   $dest_file"
      
      # Check if destination exists and compare
      if [[ ! -f "$dest_file" ]]; then
        # File doesn't exist locally - always pull
        if cp "$file" "$dest_file" 2>/dev/null; then
          ((files_copied++))
          echo "    ✓ Pulled (new): ${rel_path}"
        else
          echo "    ⚠️  Failed to pull: ${rel_path}"
        fi
      elif [[ "$file" -nt "$dest_file" ]] || ! diff -q "$file" "$dest_file" &>/dev/null; then
        # Files differ - merge instead of overwriting
        local temp_merged=$(mktemp)
        if merge_files "$dest_file" "$file" "$temp_merged"; then
          if cp "$temp_merged" "$dest_file" 2>/dev/null; then
            ((files_copied++))
            echo "    ✓ Merged (preserved existing content): ${rel_path}"
          else
            echo "    ⚠️  Failed to write merged file: ${rel_path}"
          fi
        else
          # Merge failed, fall back to pull if source is newer
          if [[ "$file" -nt "$dest_file" ]]; then
            if cp "$file" "$dest_file" 2>/dev/null; then
              ((files_copied++))
              echo "    ✓ Pulled (merge failed, source newer): ${rel_path}"
            else
              echo "    ⚠️  Failed to pull: ${rel_path}"
            fi
          else
            echo "    ⏭️  Skipped (merge failed, dest newer): ${rel_path}"
            ((files_skipped++))
          fi
        fi
        rm -f "$temp_merged" 2>/dev/null
      elif [[ "$file" -nt "$dest_file" ]]; then
        # Source is newer - pull
        if cp "$file" "$dest_file" 2>/dev/null; then
          ((files_copied++))
          echo "    ✓ Pulled (updated): ${rel_path}"
        else
          echo "    ⚠️  Failed to pull: ${rel_path}"
        fi
      else
        # Files exist and source is not newer - check if they're actually different
        # Use checksum comparison to be more accurate than timestamp
        local source_checksum=""
        local dest_checksum=""
        local checksum_tool=""
        
        # Determine which checksum tool is available
        if command -v md5sum &>/dev/null; then
          checksum_tool="md5sum"
          source_checksum=$(md5sum "$file" 2>/dev/null | cut -d' ' -f1)
          dest_checksum=$(md5sum "$dest_file" 2>/dev/null | cut -d' ' -f1)
        elif command -v md5 &>/dev/null; then
          checksum_tool="md5"
          source_checksum=$(md5 -q "$file" 2>/dev/null)
          dest_checksum=$(md5 -q "$dest_file" 2>/dev/null)
        elif command -v shasum &>/dev/null; then
          checksum_tool="shasum"
          source_checksum=$(shasum -a 256 "$file" 2>/dev/null | cut -d' ' -f1)
          dest_checksum=$(shasum -a 256 "$dest_file" 2>/dev/null | cut -d' ' -f1)
        fi
        
        # If checksum comparison failed or tools aren't available, use file size and diff as fallback
        if [[ -z "$source_checksum" || -z "$dest_checksum" ]]; then
          # Fallback: compare file sizes and do a quick diff
          local source_size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo "0")
          local dest_size=$(stat -f%z "$dest_file" 2>/dev/null || stat -c%s "$dest_file" 2>/dev/null || echo "0")
          
          if [[ "$source_size" != "$dest_size" ]]; then
            # Different sizes - definitely different, merge them
            local temp_merged=$(mktemp)
            if merge_files "$dest_file" "$file" "$temp_merged"; then
              if cp "$temp_merged" "$dest_file" 2>/dev/null; then
                ((files_copied++))
                echo "    ✓ Merged (size differs: ${source_size} vs ${dest_size}): ${rel_path}"
              else
                echo "    ⚠️  Failed to write merged file: ${rel_path}"
              fi
            else
              if [[ "$file" -nt "$dest_file" ]]; then
                if cp "$file" "$dest_file" 2>/dev/null; then
                  ((files_copied++))
                  echo "    ✓ Pulled (merge failed, size differs): ${rel_path}"
                else
                  echo "    ⚠️  Failed to pull: ${rel_path}"
                fi
              else
                ((files_skipped++))
                echo "    ⏭️  Skipped (merge failed, dest newer): ${rel_path}"
              fi
            fi
            rm -f "$temp_merged" 2>/dev/null
          elif command -v diff &>/dev/null; then
            # Same size - do a quick diff check
            if ! diff -q "$file" "$dest_file" &>/dev/null; then
              # Files differ - merge them
              local temp_merged=$(mktemp)
              if merge_files "$dest_file" "$file" "$temp_merged"; then
                if cp "$temp_merged" "$dest_file" 2>/dev/null; then
                  ((files_copied++))
                  echo "    ✓ Merged (content differs per diff): ${rel_path}"
                else
                  echo "    ⚠️  Failed to write merged file: ${rel_path}"
                fi
              else
                if [[ "$file" -nt "$dest_file" ]]; then
                  if cp "$file" "$dest_file" 2>/dev/null; then
                    ((files_copied++))
                    echo "    ✓ Pulled (merge failed, content differs): ${rel_path}"
                  else
                    echo "    ⚠️  Failed to pull: ${rel_path}"
                  fi
                else
                  ((files_skipped++))
                  echo "    ⏭️  Skipped (merge failed, dest newer): ${rel_path}"
                fi
              fi
              rm -f "$temp_merged" 2>/dev/null
            else
              # Files are the same
              ((files_skipped++))
              echo "    ⏭️  Skipped (identical): ${rel_path}"
            fi
          else
            # No diff tool either - be conservative and pull to be safe
            if cp "$file" "$dest_file" 2>/dev/null; then
              ((files_copied++))
              echo "    ✓ Pulled (cannot verify, syncing to be safe): ${rel_path}"
            else
              echo "    ⚠️  Failed to pull: ${rel_path}"
            fi
          fi
        elif [[ "$source_checksum" != "$dest_checksum" ]]; then
          # Checksums differ - files are different, merge them
          local temp_merged=$(mktemp)
          if merge_files "$dest_file" "$file" "$temp_merged"; then
            if cp "$temp_merged" "$dest_file" 2>/dev/null; then
              ((files_copied++))
              echo "    ✓ Merged (content differs per ${checksum_tool}): ${rel_path}"
            else
              echo "    ⚠️  Failed to write merged file: ${rel_path}"
            fi
          else
            # Merge failed, pull source if it's newer
            if [[ "$file" -nt "$dest_file" ]]; then
              if cp "$file" "$dest_file" 2>/dev/null; then
                ((files_copied++))
                echo "    ✓ Pulled (merge failed, content differs): ${rel_path}"
              else
                echo "    ⚠️  Failed to pull: ${rel_path}"
              fi
            else
              ((files_skipped++))
              echo "    ⏭️  Skipped (merge failed, dest newer): ${rel_path}"
            fi
          fi
          rm -f "$temp_merged" 2>/dev/null
        else
          # Checksums match - but verify with diff to catch silent checksum failures
          if command -v diff &>/dev/null; then
            if diff -q "$file" "$dest_file" &>/dev/null; then
              # Files are truly identical
              ((files_skipped++))
              echo "    ⏭️  Skipped (identical per ${checksum_tool} and diff): ${rel_path}"
            else
              # Checksum said identical but diff shows difference - checksum may have failed
              # Pull to be safe
              if cp "$file" "$dest_file" 2>/dev/null; then
                ((files_copied++))
                echo "    ✓ Pulled (checksum matched but diff shows difference): ${rel_path}"
              else
                echo "    ⚠️  Failed to pull: ${rel_path}"
              fi
            fi
          else
            # No diff tool - trust checksum (but this is less reliable)
            ((files_skipped++))
            echo "    ⏭️  Skipped (identical per ${checksum_tool}): ${rel_path}"
          fi
        fi
      fi
    fi
  done < <(find "$source_dir" -type f \( -name "*.md" -o -name "*.txt" \) ! -name "*.banter.*" ! -name "*.backup.*" ! -name ".*" ! -name ".txt" ! -name ".md" 2>/dev/null)
  
  if [[ $files_copied -gt 0 ]]; then
    echo "  📊 Pull summary: ${files_copied} pulled, ${files_skipped} skipped (identical), ${total_files} total"
    
    # Commit the pulled changes
    init_gtd_git_repo
    
    # Check if we're in a git repo
    local git_root=""
    if git rev-parse --git-dir &>/dev/null; then
      git_root=$(git rev-parse --show-toplevel 2>/dev/null)
    fi
    
    # If not in a git repo, try GTD_BASE_DIR
    if [[ -z "$git_root" && -d "$GTD_BASE_DIR/.git" ]]; then
    cd "$GTD_BASE_DIR" || return 1
      git_root="$GTD_BASE_DIR"
    elif [[ -n "$git_root" ]]; then
      cd "$git_root" || return 1
    fi
    
    if [[ -n "$git_root" && -d "$git_root/.git" ]]; then
    git add -A 2>/dev/null || true
    if ! git diff --staged --quiet 2>/dev/null; then
      local timestamp=$(date +"%Y-%m-%d %H:%M:%S")
      git commit -m "Sync from Second Brain - ${timestamp}" --quiet 2>/dev/null && {
        echo "  ✓ Committed pulled changes"
      }
    fi
    fi
  else
    echo "  ℹ️  No files to pull (all identical)"
  fi
}

# Sync daily logs to Second Brain directory (for syncing between computers)
sync_daily_logs() {
  # Preserve computer mode before sync
  if declare -f gtd_preserve_computer_mode &>/dev/null; then
    gtd_preserve_computer_mode "before"
  fi
  
  echo "🔄 Syncing Daily Logs to Second Brain (Git-based)..."
  
  local sync_dir="${SECOND_BRAIN}/Daily Logs"
  
  # Create sync directory
  mkdir -p "$sync_dir"
  mkdir -p "$DAILY_LOG_DIR"
  
  if [[ ! -d "$DAILY_LOG_DIR" ]]; then
    echo "⚠️  Daily log directory not found: $DAILY_LOG_DIR"
    return 0  # Don't fail, just skip
  fi
  
  # Sync local → Second Brain using git
  echo "  Syncing local → Second Brain..."
  git_sync_to_second_brain "$DAILY_LOG_DIR" "$sync_dir" "daily-logs"
  
  # Sync Second Brain → local (pull new/updated files)
  echo "  Syncing Second Brain → local..."
  git_sync_from_second_brain "$sync_dir" "$DAILY_LOG_DIR"
  
  echo "  ✓ Daily logs synced to: ${sync_dir}"
  echo "    (Will sync automatically via Obsidian to other computers)"
  
  # Restore computer mode after sync if it was changed
  if declare -f gtd_preserve_computer_mode &>/dev/null; then
    gtd_preserve_computer_mode "after"
  fi
}

# Main sync function
main_sync() {
  # Preserve computer mode before sync
  if declare -f gtd_preserve_computer_mode &>/dev/null; then
    gtd_preserve_computer_mode "before"
  fi
  
  echo "🧠 GTD ↔ Second Brain Sync"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  
  sync_projects
  echo ""
  sync_areas
  echo ""
  sync_references
  echo ""
  sync_daily_logs
  
  echo ""
  echo "✓ Sync complete!"
  
  # Restore computer mode after sync if it was changed
  if declare -f gtd_preserve_computer_mode &>/dev/null; then
    gtd_preserve_computer_mode "after"
  fi
}

# Show usage
show_usage() {
  cat <<EOF
Usage: gtd-brain-sync [command]

Commands:
  (no args)    Full sync (projects, areas, references, daily logs)
  projects     Sync only projects
  areas        Sync only areas
  references   Sync only references
  daily-logs   Sync daily logs to Second Brain

This command creates bidirectional links between GTD items and Second Brain notes,
following the PARA method (Projects, Areas, Resources, Archives).

EOF
}

# Main command handler
case "${1:-}" in
  projects)
    sync_projects
    ;;
  areas)
    sync_areas
    ;;
  references)
    sync_references
    ;;
  daily-logs)
    sync_daily_logs
    ;;
  "")
    main_sync
    ;;
  *)
    show_usage
    exit 1
    ;;
esac

