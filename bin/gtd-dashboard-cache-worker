#!/bin/bash
# GTD Dashboard Cache Worker Wrapper
# Starts the background worker that maintains dashboard cache

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Get Python path
MCP_PYTHON=$(command -v python3)
if [[ -z "$MCP_PYTHON" ]]; then
    echo "Error: python3 not found" >&2
    exit 1
fi

# Worker script path
WORKER_SCRIPT="$DOTFILES_DIR/mcp/gtd_dashboard_cache_worker.py"

if [[ ! -f "$WORKER_SCRIPT" ]]; then
    echo "Error: Worker script not found: $WORKER_SCRIPT" >&2
    exit 1
fi

# Log file
LOG_FILE="/tmp/dashboard-cache-worker.log"

# Check if already running
if pgrep -f "gtd_dashboard_cache_worker.py" >/dev/null; then
    echo "Dashboard cache worker is already running"
    exit 0
fi

# Start worker
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting Dashboard Cache Worker" >> "$LOG_FILE"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Cache file: $HOME/Documents/gtd/.dashboard_cache.json" >> "$LOG_FILE"

# Run worker in background
nohup "$MCP_PYTHON" "$WORKER_SCRIPT" >> "$LOG_FILE" 2>&1 &

sleep 1

if pgrep -f "gtd_dashboard_cache_worker.py" >/dev/null; then
    echo "✓ Dashboard cache worker started"
    echo "  Log: $LOG_FILE"
    echo "  Cache: $HOME/Documents/gtd/.dashboard_cache.json"
else
    echo "✗ Failed to start dashboard cache worker"
    echo "  Check log: $LOG_FILE"
    exit 1
fi


