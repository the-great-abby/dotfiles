#!/bin/bash
# gtd-auto-suggest-schedule - Setup scheduler for auto-suggest
#
# Manages launchd job for automatic suggestion implementation

set -euo pipefail

# Get the directory where this script lives
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"
TEMPLATE_PLIST="$DOTFILES_DIR/launchd/com.gtd.auto-suggest.plist"
INSTALL_PLIST="$HOME/Library/LaunchAgents/com.gtd.auto-suggest.plist"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

usage() {
    cat << EOF
Usage: gtd-auto-suggest-schedule <command> [options]

Commands:
    install         Install scheduled auto-suggest
    uninstall       Remove scheduled auto-suggest
    status          Show scheduler status
    logs            Show recent scheduler logs
    test            Test run (immediate execution)
    config          Configure schedule settings

Options:
    --hour H        Hour to run (0-23, default: 3)
    --minute M      Minute to run (0-59, default: 0)
    --daily         Run daily (default)
    --hourly        Run every hour
    --custom        Custom interval (requires --hour and --minute)

Examples:
    # Install with default schedule (daily at 3 AM - runs while you sleep)
    gtd-auto-suggest-schedule install

    # Install with custom time (daily at 9 AM)
    gtd-auto-suggest-schedule install --hour 9 --minute 0

    # Run every hour
    gtd-auto-suggest-schedule install --hourly

    # Check status
    gtd-auto-suggest-schedule status

    # View logs
    gtd-auto-suggest-schedule logs

    # Uninstall
    gtd-auto-suggest-schedule uninstall

EOF
    exit 0
}

install_schedule() {
    local hour="${1:-3}"
    local minute="${2:-0}"
    local interval="${3:-daily}"
    
    if [[ -f "$INSTALL_PLIST" ]]; then
        echo -e "${YELLOW}Auto-suggest scheduler is already installed${NC}"
        echo -n "Reinstall? (y/N): "
        read response
        if [[ ! "$response" =~ ^[Yy]$ ]]; then
            echo "Cancelled"
            exit 0
        fi
        
        # Unload existing
        launchctl unload "$INSTALL_PLIST" 2>/dev/null || true
    fi
    
    echo "Installing auto-suggest scheduler..."
    
    # Create plist from template
    sed -e "s|__DOTFILES_DIR__|$DOTFILES_DIR|g" \
        -e "s|__HOME_DIR__|$HOME|g" \
        "$TEMPLATE_PLIST" > "$INSTALL_PLIST"
    
    # Modify schedule based on interval
    if [[ "$interval" == "hourly" ]]; then
        # Replace StartCalendarInterval with hourly interval
        /usr/bin/plutil -replace StartInterval -integer 3600 "$INSTALL_PLIST"
        /usr/bin/plutil -remove StartCalendarInterval "$INSTALL_PLIST"
    else
        # Update hour and minute
        /usr/bin/plutil -replace StartCalendarInterval.Hour -integer "$hour" "$INSTALL_PLIST"
        /usr/bin/plutil -replace StartCalendarInterval.Minute -integer "$minute" "$INSTALL_PLIST"
    fi
    
    # Load the plist
    launchctl load "$INSTALL_PLIST"
    
    echo -e "${GREEN}✓ Auto-suggest scheduler installed${NC}"
    echo ""
    if [[ "$interval" == "hourly" ]]; then
        echo "  Schedule: Every hour"
    else
        echo "  Schedule: Daily at $(printf "%02d:%02d" "$hour" "$minute")"
        if [[ "$hour" -ge 0 && "$hour" -le 5 ]]; then
            echo "  🌙 Runs in the middle of the night while you sleep"
        fi
    fi
    echo "  Logs: ~/Documents/gtd/auto_suggest_scheduled.log"
    echo "  Errors: ~/Documents/gtd/auto_suggest_scheduled_error.log"
    echo ""
    echo "  To uninstall: gtd-auto-suggest-schedule uninstall"
    echo "  To view logs: gtd-auto-suggest-schedule logs"
    echo ""
    echo -e "${YELLOW}⚠️  Make sure auto-suggest is enabled first:${NC}"
    echo "     gtd-auto-suggest enable --live"
}

uninstall_schedule() {
    if [[ ! -f "$INSTALL_PLIST" ]]; then
        echo "Auto-suggest scheduler is not installed"
        exit 0
    fi
    
    echo "Uninstalling auto-suggest scheduler..."
    
    # Unload the plist
    launchctl unload "$INSTALL_PLIST" 2>/dev/null || true
    
    # Remove the plist
    rm -f "$INSTALL_PLIST"
    
    echo -e "${GREEN}✓ Auto-suggest scheduler uninstalled${NC}"
}

show_status() {
    if [[ ! -f "$INSTALL_PLIST" ]]; then
        echo "Auto-suggest scheduler: NOT INSTALLED"
        echo ""
        echo "To install: gtd-auto-suggest-schedule install"
        exit 0
    fi
    
    echo "Auto-suggest Scheduler Status"
    echo "="*60
    echo ""
    echo "Installed: YES"
    echo "Plist: $INSTALL_PLIST"
    echo ""
    
    # Check if loaded
    if launchctl list | grep -q "com.gtd.auto-suggest"; then
        echo "Status: LOADED"
    else
        echo "Status: NOT LOADED"
        echo ""
        echo "To load: launchctl load $INSTALL_PLIST"
    fi
    
    # Show schedule
    echo ""
    echo "Schedule:"
    if /usr/bin/plutil -extract StartInterval xml1 "$INSTALL_PLIST" -o - 2>/dev/null | grep -q "<integer>"; then
        interval=$(/usr/bin/plutil -extract StartInterval xml1 "$INSTALL_PLIST" -o - | grep -oP '(?<=<integer>)\d+' || echo "3600")
        hours=$((interval / 3600))
        echo "  Every $hours hour(s)"
    else
        hour=$(/usr/bin/plutil -extract StartCalendarInterval.Hour xml1 "$INSTALL_PLIST" -o - | grep -oP '(?<=<integer>)\d+' || echo "9")
        minute=$(/usr/bin/plutil -extract StartCalendarInterval.Minute xml1 "$INSTALL_PLIST" -o - | grep -oP '(?<=<integer>)\d+' || echo "0")
        echo "  Daily at $(printf "%02d:%02d" "$hour" "$minute")"
    fi
    
    echo ""
    echo "Logs:"
    echo "  Output: ~/Documents/gtd/auto_suggest_scheduled.log"
    echo "  Errors: ~/Documents/gtd/auto_suggest_scheduled_error.log"
}

show_logs() {
    local log_file="$HOME/Documents/gtd/auto_suggest_scheduled.log"
    local err_file="$HOME/Documents/gtd/auto_suggest_scheduled_error.log"
    
    echo "Auto-suggest Scheduled Logs"
    echo "="*60
    echo ""
    
    if [[ -f "$log_file" ]]; then
        echo "Output log (last 50 lines):"
        echo ""
        tail -50 "$log_file"
    else
        echo "No output log found"
    fi
    
    echo ""
    echo "="*60
    echo ""
    
    if [[ -f "$err_file" ]]; then
        echo "Error log (last 50 lines):"
        echo ""
        tail -50 "$err_file"
    else
        echo "No error log found"
    fi
}

test_run() {
    echo "Running auto-suggest test (immediate execution)..."
    echo ""
    "$DOTFILES_DIR/bin/gtd-auto-suggest" run
}

# Main command dispatcher
main() {
    if [[ $# -eq 0 ]]; then
        usage
    fi
    
    local command="$1"
    shift
    
    case "$command" in
        install)
            local hour=9
            local minute=0
            local interval="daily"
            
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --hour)
                        hour="$2"
                        shift 2
                        ;;
                    --minute)
                        minute="$2"
                        shift 2
                        ;;
                    --hourly)
                        interval="hourly"
                        shift
                        ;;
                    --daily)
                        interval="daily"
                        shift
                        ;;
                    *)
                        echo "Unknown option: $1"
                        exit 1
                        ;;
                esac
            done
            
            install_schedule "$hour" "$minute" "$interval"
            ;;
        uninstall)
            uninstall_schedule
            ;;
        status)
            show_status
            ;;
        logs)
            show_logs
            ;;
        test)
            test_run
            ;;
        config)
            # Open the plist in editor
            if [[ -f "$INSTALL_PLIST" ]]; then
                ${EDITOR:-vim} "$INSTALL_PLIST"
                echo ""
                echo "After editing, reload with:"
                echo "  launchctl unload $INSTALL_PLIST"
                echo "  launchctl load $INSTALL_PLIST"
            else
                echo "Scheduler not installed. Install first with:"
                echo "  gtd-auto-suggest-schedule install"
            fi
            ;;
        help|--help|-h)
            usage
            ;;
        *)
            echo "Unknown command: $command"
            echo "Run 'gtd-auto-suggest-schedule help' for usage"
            exit 1
            ;;
    esac
}

main "$@"

