#!/bin/bash
# Claude GTD - Hybrid AI system CLI wrapper
# Calls the Python client with proper environment setup

set -e

# Find the script directory
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
DOTFILES_DIR="$( dirname "$SCRIPT_DIR" )"

# Find Python
PYTHON_CMD="python3"
if ! command -v "$PYTHON_CMD" &> /dev/null; then
    PYTHON_CMD="python"
fi

# Make sure PYTHONPATH includes dotfiles
export PYTHONPATH="${DOTFILES_DIR}:${PYTHONPATH}"

# Run the client
"$PYTHON_CMD" "${DOTFILES_DIR}/mcp/claude_gtd_client.py" "$@"
